# Root build context: allow only backend runtime inputs, never frontend/data.
**
!backend/
!backend/Dockerfile
!backend/requirements.txt
!backend/alembic.ini
!backend/app/
!backend/app/**
!backend/migrations/
!backend/migrations/**
!core/
!core/__init__.py
!core/rules/
!core/rules/**
!core/models/
!core/models/*.py
!core/models/saved/
!core/models/saved/*.joblib
**/__pycache__
**/*.py[cod]
**/.env
**/.env.*
**/*.db
**/*.sqlite*
**/*.pem
**/*.key
**/*.log
# Seed database only (copied to /app/seed, see backend/Dockerfile); must stay last.
!backend/data/
!backend/data/credx.db
