# Generate a secret with scripts/init_env.py; never commit your real .env.
JWT_SECRET=
# Defaults to backend/data/credx.db regardless of the server working directory.
# DATABASE_URL=sqlite:///./data/credx.db
JWT_ISSUER=credx-api
JWT_AUDIENCE=credx-client
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900
# Explicit browser origins only; defaults to no cross-origin access.
CORS_ORIGINS=[]
