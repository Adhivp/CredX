# Base URL of the CredX API, including the /api/v1 prefix.
# Leave empty in development: requests go to the same origin and the Astro dev server
# proxies /api and /health to CREDX_API_PROXY_TARGET.
# For a deployed build, set the API origin and add this site's origin to the backend's
# CORS_ORIGINS. Never put secrets here: PUBLIC_ variables are shipped to the browser.
PUBLIC_API_BASE_URL=

# Development proxy target (not shipped to the browser).
CREDX_API_PROXY_TARGET=http://localhost:8000
