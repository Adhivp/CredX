---
import Layout from '../layouts/Layout.astro';
import AmbientMesh from '../components/common/AmbientMesh.astro';
import BrandShowcase from '../components/auth/BrandShowcase.astro';
import LoginForm from '../components/auth/LoginForm.astro';
---

<Layout public title="CredX — Sign In" description="Sign in to CredX credit deterioration intelligence.">
	<main class="auth-container" id="auth-page">
		<!-- Ambient Gold Glow & Mesh Background -->
		<AmbientMesh />

		<!-- Left Showcase Panel -->
		<BrandShowcase />

		<!-- Right Authentication Card -->
		<LoginForm />
	</main>
</Layout>
