  async function uploadCSV(csvText, dataType, filename) {
    const blob = new Blob([csvText], { type: 'text/csv' });
    const file = new File([blob], filename, { type: 'text/csv' });
    const formData = new FormData();
    formData.append('file', file);
    const res = await fetch(`/api/v1/ews/upload?data_type=${dataType}`, { method: 'POST', body: formData });
    return res.json();
  }

  document.getElementById('loadSampleBtn').addEventListener('click', async () => {
    const btn = document.getElementById('loadSampleBtn');
    const sampleResult = document.getElementById('sampleResult');
    btn.disabled = true;
    btn.textContent = '⏳ Loading...';
    sampleResult.innerHTML = '';
    const steps = [
      { csv: SAMPLE_CUSTOMERS, type: 'customers', name: 'customers.csv' },
      { csv: SAMPLE_LOANS, type: 'loans', name: 'loans.csv' },
      { csv: SAMPLE_REPAYMENTS, type: 'repayments', name: 'repayments.csv' },
      { csv: SAMPLE_EXPOSURE, type: 'exposure', name: 'exposure.csv' },
      { csv: SAMPLE_CASHFLOW, type: 'cashflow', name: 'cashflow.csv' },
    ];
    let html = '';
    let allOk = true;
    for (const step of steps) {
      try {
        const r = await uploadCSV(step.csv, step.type, step.name);
        if (r.status === 'success') {
          html += `<p style="color:#22C55E;font-size:0.8125rem;">✓ ${step.name}: ${r.records_loaded} records</p>`;
        } else {
          html += `<p style="color:#EF4444;font-size:0.8125rem;">✗ ${step.name}: ${r.detail || 'failed'}</p>`;
          allOk = false;
        }
      } catch (e) {
        html += `<p style="color:#EF4444;font-size:0.8125rem;">✗ ${step.name}: ${e.message}</p>`;
        allOk = false;
      }
    }
    if (allOk) {
      html += `<p style="color:#22C55E;margin-top:0.75rem;font-weight:600;">All sample data loaded! Go to <a href="/dashboard" style="color:var(--accent)">Dashboard</a> and click Run Assessment.</p>`;
    }
    sampleResult.innerHTML = html;
    btn.disabled = false;
    btn.textContent = 'Load Sample Data';
  });
</script>
