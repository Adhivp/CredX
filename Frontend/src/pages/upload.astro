---
import Layout from "../layouts/Layout.astro";
import DashboardNav from "../components/dashboard/DashboardNav.astro";
import OfficerProfileHeader from "../components/dashboard/OfficerProfileHeader.astro";
---

<Layout title="CredX — Upload Data">
  <div class="dash-layout">
    <DashboardNav active="upload" />
    <main class="dash-main">
      <div class="dash-header">
        <div class="header-titles">
          <h1 class="dash-title">Upload <span class="gold-gradient-text">Portfolio Data</span></h1>
          <p class="dash-subtitle">Ingest customer profiles, loan facilities, and historical repayments.</p>
        </div>
        <div class="dash-actions">
          <a href="/dashboard" class="btn btn-glass">← Back to Dashboard</a>
          <OfficerProfileHeader />
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Data Type</label>
        <select id="dataType" class="form-select" style="max-width:300px">
          <option value="customers">Customer Profiles</option>
          <option value="loans">Loan Facilities</option>
          <option value="repayments">Repayment History</option>
          <option value="exposure">Customer Exposure</option>
          <option value="cashflow">Cash Flow Records</option>
        </select>
      </div>

      <div id="columnHint" class="form-group" style="font-size:0.75rem;color:var(--text-muted);"></div>

      <div id="dropZone" class="upload-zone">
        <div class="upload-zone-icon">📁</div>
        <div class="upload-zone-text">
          Drag & drop your file here, or <strong>click to browse</strong>
        </div>
        <div class="upload-zone-hint">Supports CSV, Excel (.xlsx) and JSON</div>
      </div>
      <input type="file" id="fileInput" accept=".csv,.xlsx,.xls,.json" style="display:none" />

      <div id="fileInfo" style="margin-top:1rem;font-size:0.8125rem;color:var(--text-secondary);display:none;"></div>

      <button id="uploadBtn" class="btn btn-primary" style="margin-top:1rem;display:none;">
        ⬆ Upload
      </button>

      <div id="result"></div>

      <div style="margin-top:2rem;padding-top:2rem;border-top:1px solid var(--border-subtle)">
        <h3 style="font-size:0.875rem;color:var(--text-secondary);margin-bottom:1rem;">Quick Load — Sample Data</h3>
        <p style="font-size:0.75rem;color:var(--text-muted);margin-bottom:1rem;">Uploads 10 customers, 11 loans, 86 repayments, 13 exposure records, and 74 cash flow records covering all EWS scenarios. Loading it again updates the same records instead of duplicating them.</p>
        <button id="loadSampleBtn" class="btn btn-primary">Load Sample Data</button>
        <div id="sampleResult" style="margin-top:1rem;"></div>
      </div>
    </main>
  </div>
</Layout>

<script>
  const COLUMN_HINTS = {
    customers: 'Required: customer_id, customer_type. Optional: employment_category, portfolio_segment',
    loans: 'Required: customer_id, loan_id, product_type, sanctioned_amount, outstanding_balance',
    repayments: 'Required: customer_id, loan_id, due_date, amount_due, amount_paid, repayment_status',
    exposure: 'Required: customer_id, facility_type, outstanding_balance',
    cashflow: 'Required: customer_id, month, monthly_inflow',
  };

  const typeSelect = document.getElementById('dataType');
  const hintEl = document.getElementById('columnHint');
  const dropZone = document.getElementById('dropZone');
  const fileInput = document.getElementById('fileInput');
  const fileInfo = document.getElementById('fileInfo');
  const uploadBtn = document.getElementById('uploadBtn');
  const resultEl = document.getElementById('result');

  let selectedFile = null;

  function updateHint() {
    hintEl.textContent = COLUMN_HINTS[typeSelect.value] || '';
  }
  typeSelect.addEventListener('change', updateHint);
  updateHint();

  dropZone.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('dragover'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('dragover');
    if (e.dataTransfer.files.length) handleFile(e.dataTransfer.files[0]);
  });

  fileInput.addEventListener('change', () => {
    if (fileInput.files.length) handleFile(fileInput.files[0]);
  });

  function handleFile(file) {
    selectedFile = file;
    const size = (file.size / 1024).toFixed(1);
    fileInfo.style.display = 'block';
    fileInfo.innerHTML = `📄 <strong>${file.name}</strong> (${size} KB)`;
    uploadBtn.style.display = 'inline-flex';
    resultEl.innerHTML = '';
  }

  uploadBtn.addEventListener('click', async () => {
    if (!selectedFile) return;
    uploadBtn.disabled = true;
    uploadBtn.textContent = '⏳ Uploading…';

    const formData = new FormData();
    formData.append('file', selectedFile);

    try {
      const res = await fetch(`/api/v1/ews/upload?data_type=${typeSelect.value}`, {
        method: 'POST',
        body: formData,
      });
      const data = await res.json();

      if (res.ok && data.status === 'success') {
        resultEl.innerHTML = `
          <div class="upload-result success">
            <strong style="color:#22C55E">✓ Upload Successful</strong>
            <p style="margin-top:0.5rem;font-size:0.8125rem;color:var(--text-secondary)">
              Loaded <strong>${data.records_loaded}</strong> records from <strong>${data.filename}</strong>
            </p>
            ${data.errors && data.errors.length ? `<p style="margin-top:0.5rem;font-size:0.75rem;color:#F59E0B">Warnings: ${data.errors.join(', ')}</p>` : ''}
          </div>`;
      } else {
        const errMsg = data.detail || data.errors?.join(', ') || 'Unknown error';
        resultEl.innerHTML = `
          <div class="upload-result error">
            <strong style="color:#EF4444">✗ Upload Failed</strong>
            <p style="margin-top:0.5rem;font-size:0.8125rem;color:var(--text-secondary)">${errMsg}</p>
          </div>`;
      }
    } catch (err) {
      resultEl.innerHTML = `
        <div class="upload-result error">
          <strong style="color:#EF4444">✗ Connection Error</strong>
          <p style="margin-top:0.5rem;font-size:0.8125rem;color:var(--text-secondary)">${err.message}</p>
        </div>`;
    }

    uploadBtn.disabled = false;
    uploadBtn.textContent = '⬆ Upload';
    selectedFile = null;
    fileInput.value = '';
    fileInfo.style.display = 'none';
  });

