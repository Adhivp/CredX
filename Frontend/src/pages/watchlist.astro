---
import AppShell from '../layouts/AppShell.astro';
---

<AppShell title="Watchlist" page="watchlist">
	<header class="page-head">
		<div>
			<h1 class="page-head__title page-head__title--sm">Customer watchlist</h1>
			<p class="page-head__lede" id="wl-lede">Customers with a warning assessment, highest warning score first.</p>
		</div>
		<form class="wl-find" id="wl-find" role="search">
			<label class="sr-only" for="wl-find-id">Open a customer by exact ID</label>
			<input class="input" id="wl-find-id" name="id" placeholder="Open customer by exact ID" autocomplete="off" spellcheck="false" maxlength="64" required />
			<button class="btn btn--secondary" type="submit">Open</button>
		</form>
	</header>

	<section class="panel panel--flush" aria-labelledby="wl-title">
		<h2 class="sr-only" id="wl-title">Watchlist</h2>
		<form class="wl-filters filters" id="wl-filters">
			<div class="field">
				<label class="field__label" for="f-risk">Risk category</label>
				<select class="input" id="f-risk" name="risk_level">
					<option value="">All categories</option>
					<option value="Critical">Critical</option>
					<option value="High">High</option>
					<option value="Medium">Medium</option>
					<option value="Low">Low</option>
					<option value="Insufficient Data">Insufficient data</option>
				</select>
			</div>
			<div class="field" id="f-product-field"></div>
			<div class="field" id="f-segment-field"></div>
			<div class="field wl-filters__score">
				<label class="field__label" for="f-score">Minimum warning score</label>
				<input class="input" id="f-score" name="min_score" type="number" min="0" max="100" step="5" placeholder="0" inputmode="decimal" />
			</div>
			<div class="wl-filters__actions">
				<button type="submit" class="btn btn--primary btn--sm">Apply</button>
				<button type="button" class="btn btn--ghost btn--sm" id="wl-reset">Reset</button>
			</div>
		</form>
		<div class="wl-status" id="wl-status" aria-live="polite"></div>
		<div class="table-wrap wl-table-wrap">
			<table class="table wl-table">
				<thead>
					<tr>
						<th scope="col" class="wl-sticky">Customer</th>
						<th scope="col">Product</th>
						<th scope="col" class="num wl-wrap" title="Outstanding balance of the customer's largest facility"><button type="button" class="th-sort" data-sort="outstanding_exposure">Outstanding, largest facility</button></th>
						<th scope="col"><button type="button" class="th-sort" data-sort="warning_score" aria-sort="descending">Warning score</button></th>
						<th scope="col">Risk</th>
						<th scope="col" title="Component scores above 20 out of repayment delay, missed payments, exposure and cash flow"><button type="button" class="th-sort" data-sort="active_signals">Active signals</button></th>
						<th scope="col">Primary indicators</th>
						<th scope="col">Investigation</th>
						<th scope="col"><span class="sr-only">Action</span></th>
					</tr>
				</thead>
				<tbody id="wl-body"></tbody>
			</table>
		</div>
		<div id="wl-empty"></div>
		<nav class="pager" id="wl-pager" aria-label="Watchlist pages" hidden></nav>
	</section>
</AppShell>

<script>
	import { portfolioSummary, watchlist } from '../lib/api/ews';
	import { portfolioIntelligence } from '../lib/api/governance';
	import { isAbort } from '../lib/api/client';
	import { count, humanize, money } from '../lib/format';
	import { html, mount } from '../lib/html';
	import { $, $$, definePage, navigate, setParams, type PageContext } from '../lib/page';
	import { can } from '../lib/permissions';
	import type { WatchlistEntry, WatchlistQuery } from '../lib/types';
	import { emptyState, errorState, riskBadge, scoreBar, statusPill } from '../lib/ui';

	const PAGE_SIZE = 25;
	type SortKey = 'warning_score' | 'outstanding_exposure' | 'active_signals';
	let sort: { key: SortKey; dir: 1 | -1 } = { key: 'warning_score', dir: -1 };
	let rows: WatchlistEntry[] = [];

	function queryFromUrl(): WatchlistQuery & { page: number } {
		const p = new URLSearchParams(location.search);
		const minScore = Number(p.get('min_score'));
		return {
			risk_level: p.get('risk_level') ?? undefined,
			product_type: p.get('product_type') ?? undefined,
			customer_segment: p.get('customer_segment') ?? undefined,
			min_score: Number.isFinite(minScore) && minScore > 0 ? Math.min(100, minScore) : undefined,
			page: Math.max(1, Number(p.get('page')) || 1),
		};
	}

	function choiceField(id: string, name: string, label: string, options: string[] | null, value?: string) {
		if (options && options.length) {
			const values = value && !options.includes(value) ? [value, ...options] : options;
			return html`<label class="field__label" for="${id}">${label}</label><select class="input" id="${id}" name="${name}">
				<option value="">All</option>${values.map((o) => html`<option value="${o}" ${o === value ? 'selected' : ''}>${humanize(o)}</option>`)}</select>`;
		}
		return html`<label class="field__label" for="${id}">${label}</label><input class="input" id="${id}" name="${name}" value="${value ?? ''}" placeholder="Exact value" maxlength="64" />`;
	}

	function renderRows() {
		const sorted = [...rows].sort((a, b) => (a[sort.key] - b[sort.key]) * sort.dir);
		$$<HTMLButtonElement>('.th-sort').forEach((b) =>
			b.dataset.sort === sort.key ? b.setAttribute('aria-sort', sort.dir === 1 ? 'ascending' : 'descending') : b.removeAttribute('aria-sort'),
		);
		mount(
			$('#wl-body'),
			html`${sorted.map((r) => {
				const href = `/customer?id=${encodeURIComponent(r.customer_id)}`;
				return html`<tr class="is-link" data-href="${href}">
					<td class="wl-sticky"><a class="row-link" href="${href}">${r.customer_id}</a></td>
					<td class="nowrap">${r.product_type ? humanize(r.product_type) : html`<span class="muted">No facility</span>`}</td>
					<td class="num">${r.product_type ? money(r.outstanding_exposure) : html`<span class="muted">—</span>`}</td>
					<td>${scoreBar(r.warning_score, r.risk_category)}</td>
					<td>${riskBadge(r.risk_category, 'sm')}</td>
					<td class="num" data-tip="${r.active_signals} of 4 component scores above 20">${r.active_signals}<span class="muted"> / 4</span></td>
					<td><span class="indicators">${r.top_indicators.length ? r.top_indicators.map((i) => html`<span title="${i}">${i}</span>`) : html`<span class="muted">None recorded</span>`}</span></td>
					<td>${statusPill(r.monitoring_status)}</td>
					<td><a class="btn btn--ghost btn--sm" href="${href}" aria-label="Review ${r.customer_id}">Review</a></td>
				</tr>`;
			})}`,
		);
	}

	async function refresh(ctx: PageContext) {
		const q = queryFromUrl();
		const body = $('#wl-body');
		const status = $('#wl-status');
		const empty = $('#wl-empty');
		const pager = $('#wl-pager');
		if (body && !body.children.length) {
			mount(body, html`${Array.from({ length: 6 }, () => html`<tr class="wl-skeleton">${Array.from({ length: 9 }, () => html`<td><span class="skeleton skeleton--line"></span></td>`)}</tr>`)}`);
		} else body?.classList.add('is-refreshing');
		mount(empty, '');
		try {
			const res = await watchlist({
				risk_level: q.risk_level,
				product_type: q.product_type,
				customer_segment: q.customer_segment,
				min_score: q.min_score,
				limit: PAGE_SIZE,
				offset: (q.page - 1) * PAGE_SIZE,
			});
			if (ctx.signal.aborted) return;
			rows = res.items;
			const filtered = Boolean(q.risk_level || q.product_type || q.customer_segment || q.min_score);
			if (!res.total) {
				mount(body, '');
				pager!.hidden = true;
				mount(status, '');
				mount(
					empty,
					filtered
						? emptyState('No customers match these filters', 'Filters match exact values. Reset them to see the full watchlist.', html`<button type="button" class="btn btn--secondary btn--sm" data-reset>Reset filters</button>`)
						: emptyState(
								'No assessed customers yet',
								can(ctx.user.role, 'run_assessment') ? 'Upload portfolio data and run an assessment to build the watchlist.' : 'Customers appear here after an analyst runs an assessment.',
								can(ctx.user.role, 'upload_data') ? html`<a class="btn btn--primary btn--sm" href="/data">Go to data and assessment</a>` : undefined,
							),
				);
				$('[data-reset]', empty!)?.addEventListener('click', reset);
				return;
			}
			const pages = Math.max(1, Math.ceil(res.total / PAGE_SIZE));
			if (q.page > pages) {
				setParams({ page: pages });
				return refresh(ctx);
			}
			const first = (q.page - 1) * PAGE_SIZE + 1;
			const last = first + res.items.length - 1;
			mount(
				status,
				html`<span>${count(first)}–${count(last)} of ${count(res.total)} customers${filtered ? ' matching filters' : ''}</span>
				<span class="muted">${sort.key === 'warning_score' && sort.dir === -1 ? 'Ordered by warning score, highest first' : 'Sorted within this page only; pages follow warning score order'}</span>`,
			);
			renderRows();
			pager!.hidden = pages <= 1;
			mount(
				pager,
				html`<span>Page ${q.page} of ${pages}</span><span class="btn-row">
					<button type="button" class="btn btn--ghost btn--sm" data-page="${q.page - 1}" ${q.page <= 1 ? 'disabled' : ''}>Previous</button>
					<button type="button" class="btn btn--ghost btn--sm" data-page="${q.page + 1}" ${q.page >= pages ? 'disabled' : ''}>Next</button></span>`,
			);
		} catch (error) {
			if (isAbort(error) || ctx.signal.aborted) return;
			mount(body, '');
			mount(status, '');
			pager!.hidden = true;
			mount(empty, errorState(error));
			$('[data-retry]', empty!)?.addEventListener('click', () => void refresh(ctx), { once: true });
		} finally {
			body?.classList.remove('is-refreshing');
		}
	}

	let current: PageContext | null = null;
	function reset() {
		const form = $<HTMLFormElement>('#wl-filters');
		form?.reset();
		$$<HTMLInputElement | HTMLSelectElement>('#wl-filters [name]').forEach((el) => (el.value = ''));
		setParams({ risk_level: null, product_type: null, customer_segment: null, min_score: null, page: null });
		if (current) void refresh(current);
	}

	definePage('watchlist', async (ctx) => {
		current = ctx;
		sort = { key: 'warning_score', dir: -1 };
		const q = queryFromUrl();
		const form = $<HTMLFormElement>('#wl-filters')!;
		($('#f-risk') as HTMLSelectElement).value = q.risk_level ?? '';
		($('#f-score') as HTMLInputElement).value = q.min_score ? String(q.min_score) : '';

		// Filter values come from the portfolio aggregate when the role can see it; otherwise exact text.
		let products: string[] | null = null;
		let segments: string[] | null = null;
		if (can(ctx.user.role, 'view_portfolio')) {
			try {
				const intel = await portfolioIntelligence();
				products = intel.products.map((g) => g.group).filter((g) => g !== 'none');
				segments = intel.segments.map((g) => g.group).filter((g) => g !== 'unspecified');
			} catch {
				// Fall back to free-text filters.
			}
		}
		if (ctx.signal.aborted) return;
		mount($('#f-product-field'), choiceField('f-product', 'product_type', 'Product', products, q.product_type));
		mount($('#f-segment-field'), choiceField('f-segment', 'customer_segment', 'Segment', segments, q.customer_segment));

		void portfolioSummary()
			.then((s) => {
				if (ctx.signal.aborted) return;
				const missing = s.total_customers - s.total_assessed;
				mount(
					$('#wl-lede'),
					`Customers with a warning assessment, highest warning score first.${missing > 0 ? ` ${count(missing)} customer${missing === 1 ? ' has' : 's have'} no assessment yet and ${missing === 1 ? 'is' : 'are'} not listed.` : ''}`,
				);
			})
			.catch(() => {});

		form.addEventListener('submit', (e) => {
			e.preventDefault();
			const data = new FormData(form);
			const min = Number(data.get('min_score'));
			setParams({
				risk_level: String(data.get('risk_level') ?? ''),
				product_type: String(data.get('product_type') ?? '').trim(),
				customer_segment: String(data.get('customer_segment') ?? '').trim(),
				min_score: Number.isFinite(min) && min > 0 ? Math.min(100, min) : null,
				page: null,
			});
			void refresh(ctx);
		});
		form.addEventListener('change', (e) => {
			if ((e.target as HTMLElement).tagName === 'SELECT') form.requestSubmit();
		});
		$('#wl-reset')?.addEventListener('click', reset);

		$$<HTMLButtonElement>('.th-sort').forEach((b) =>
			b.addEventListener('click', () => {
				const key = b.dataset.sort as SortKey;
				sort = sort.key === key ? { key, dir: sort.dir === 1 ? -1 : 1 } : { key, dir: -1 };
				renderRows();
				const note = $('#wl-status .muted');
				if (note) note.textContent = sort.key === 'warning_score' && sort.dir === -1 ? 'Ordered by warning score, highest first' : 'Sorted within this page only; pages follow warning score order';
			}),
		);

		$('#wl-pager')?.addEventListener('click', (e) => {
			const page = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-page]')?.dataset.page;
			if (!page) return;
			setParams({ page: Number(page) > 1 ? page : null });
			void refresh(ctx);
			$('#wl-title')?.closest('section')?.scrollIntoView({ block: 'start' });
		});

		// Whole-row click opens the customer (the ID link remains the keyboard path).
		$('#wl-body')?.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;
			if (target.closest('a, button')) return;
			const href = target.closest<HTMLElement>('tr[data-href]')?.dataset.href;
			if (href) void navigate(href);
		});

		$('#wl-find')?.addEventListener('submit', (e) => {
			e.preventDefault();
			const id = String(new FormData(e.target as HTMLFormElement).get('id') ?? '').trim();
			if (id) void navigate(`/customer?id=${encodeURIComponent(id)}`);
		});

		await refresh(ctx);
	});
</script>
