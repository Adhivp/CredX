---
import Layout from '../layouts/Layout.astro';
import AmbientMesh from '../components/common/AmbientMesh.astro';
import HeaderNav from '../components/landing/HeaderNav.astro';
import HeroBalance from '../components/landing/HeroBalance.astro';
import CardShowcase from '../components/landing/CardShowcase.astro';
import QuickActions from '../components/landing/QuickActions.astro';
import TransactionLedger from '../components/landing/TransactionLedger.astro';
import FinancialInsights from '../components/landing/FinancialInsights.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
---

<Layout title="CredX — Private Wealth Client Portal" description="CredX institutional and private banking client dashboard and account overview.">
	<div class="landing-page" id="landing-portal">
		<!-- Ambient Gold Glow Background -->
		<AmbientMesh />

		<!-- Luxury Sticky Navbar -->
		<HeaderNav />

		<!-- Main Dashboard Content -->
		<main class="landing-main" id="overview">
			<!-- Balance & Metal Card Grid -->
			<section class="hero-grid" aria-label="Account Summary and Metal Card">
				<HeroBalance />
				<CardShowcase />
			</section>

			<!-- Quick Banking Action Shortcuts -->
			<QuickActions />

			<!-- Cleared Activity & Cryptographic Receipt Ledger -->
			<TransactionLedger />

			<!-- Real-time Prime Ticker & Concierge Advisor -->
			<FinancialInsights />
		</main>

		<!-- Institutional Bank Footer -->
		<LandingFooter />
	</div>
</Layout>
