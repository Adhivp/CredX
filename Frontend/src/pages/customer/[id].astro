---
import Layout from "../../layouts/Layout.astro";
import DashboardNav from "../../components/dashboard/DashboardNav.astro";

const { id } = Astro.params;
---

<Layout title={`CredX — Customer Risk Dossier ${id}`}>
  <div class="dash-layout">
    <DashboardNav active="watchlist" />
    <main class="dash-main">
      <div id="customerContent">
        <div class="loading">
          <div class="pulse-dot" style="margin: 0 auto 1rem; width: 14px; height: 14px;"></div>
          Loading institutional credit dossier for <strong class="gold-text">{id}</strong>…
        </div>
      </div>
    </main>
  </div>
</Layout>

<script define:vars={{ id }}>
  const API = '/api/v1/ews';
  const customerId = id;

  async function loadCustomer() {
    const container = document.getElementById('customerContent');
    try {
      const res = await fetch(`${API}/customer/${customerId}`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      renderCustomer(data, container);
    } catch (err) {
      container.innerHTML = `
        <div class="empty-state">
          <div class="empty-state-icon">⚠️</div>
          <h3>Failed to Load Customer Dossier</h3>
          <p style="color:var(--white-60);margin-bottom:1rem;">${err.message}</p>
          <a href="/watchlist" class="btn btn-glass">← Return to Watchlist</a>
        </div>`;
    }
  }

  function getRiskMeta(score) {
    if (score >= 70) {
      return {
        cat: 'Critical',
        pillClass: 'risk-pill-critical',
        badgeClass: 'badge-critical',
        color: '#EF4444',
        gradId: 'gaugeGradCritical',
        glowColor: 'rgba(239, 68, 68, 0.45)',
        desc: 'Severe credit impairment pattern detected'
      };
    }
    if (score >= 45) {
      return {
        cat: 'High',
        pillClass: 'risk-pill-high',
        badgeClass: 'badge-high',
        color: '#F97316',
        gradId: 'gaugeGradHigh',
        glowColor: 'rgba(249, 115, 22, 0.4)',
        desc: 'Accelerating payment delinquency trend'
      };
    }
    if (score >= 20) {
      return {
        cat: 'Medium',
        pillClass: 'risk-pill-medium',
        badgeClass: 'badge-medium',
        color: '#F59E0B',
        gradId: 'gaugeGradMedium',
        glowColor: 'rgba(245, 158, 11, 0.35)',
        desc: 'Moderate early-stage payment delays'
      };
    }
    return {
      cat: 'Low',
      pillClass: 'risk-pill-low',
      badgeClass: 'badge-low',
      color: '#10B981',
      gradId: 'gaugeGradLow',
      glowColor: 'rgba(16, 185, 129, 0.35)',
      desc: 'Normal repayment performance'
    };
  }

  function formatCurrency(amount) {
    if (amount === undefined || amount === null) return '₹0';
    return '₹' + Number(amount).toLocaleString('en-IN');
  }

  function parseIndicator(text) {
    const lower = text.toLowerCase();
    let type = 'warning';
    let icon = '⚡';
    let tag = 'PAYMENT DELAY';
    let highlightClass = 'coral';

    if (lower.includes('missed') || lower.includes('consecutive') || lower.includes('streak')) {
      type = 'critical';
      icon = '⛔';
      tag = 'DELINQUENCY STREAK';
      highlightClass = 'ruby';
    } else if (lower.includes('recovery') || lower.includes('0%')) {
      type = 'warning';
      icon = '📉';
      tag = 'RECOVERY DEFICIT';
      highlightClass = 'coral';
    } else if (lower.includes('income') || lower.includes('data') || lower.includes('calculate')) {
      type = 'info';
      icon = 'ℹ️';
      tag = 'DATA HYGIENE';
      highlightClass = '';
    }

    // Format bold numbers or highlight segments
    const formatted = text.replace(/(\b\d+%?|\b\d+\s+late\/missed|\b\d+\s+consecutive)/gi, '<span class="warning-highlight ' + highlightClass + '">$1</span>');

    return { type, icon, tag, formatted };
  }

  function renderCustomer(data, container) {
    const c = data.customer || {};
    const rawAssessments = data.assessments || [];
    // Sort assessments to get latest by assessed_at
    const assessments = rawAssessments.slice().sort((a, b) => (b.assessed_at || 0) - (a.assessed_at || 0));
    const latest = assessments.length > 0 ? assessments[0] : null;

    const score = latest ? latest.warning_score : 0;
    const category = latest ? latest.risk_category : 'Low';
    const riskMeta = getRiskMeta(score);

    const loans = data.loans || [];
    const repayments = data.repayments || [];
    const alerts = data.alerts || [];

    const rawIndicators = latest ? (typeof latest.top_indicators === 'string' ? JSON.parse(latest.top_indicators) : latest.top_indicators) || [] : [];
    const indicators = rawIndicators.map(i => parseIndicator(i));

    // Calculate aggregated loan exposure
    const totalSanctioned = loans.reduce((acc, l) => acc + (l.sanctioned_amount || 0), 0);
    const totalOutstanding = loans.reduce((acc, l) => acc + (l.outstanding_balance || 0), 0);
    const utilPct = totalSanctioned > 0 ? Math.min(100, Math.round((totalOutstanding / totalSanctioned) * 100)) : 0;

    // Radial gauge circumference: 2 * PI * 82 = 515.22
    const circumference = 515.22;
    const dashOffset = circumference * (1 - Math.min(100, Math.max(0, score)) / 100);

    const cid = c.customer_id || customerId;
    const initials = cid.replace(/[^0-9A-Z]/gi, '').slice(-2) || 'CX';

    // 1. Breadcrumbs & Header Bar
    const headerHtml = `
      <div class="dossier-breadcrumbs">
        <a href="/dashboard" class="breadcrumb-link">Surveillance</a>
        <span class="breadcrumb-sep">/</span>
        <a href="/watchlist" class="breadcrumb-link">Risk Watchlist</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">Customer ${cid}</span>
      </div>

      <div class="dossier-header-bar">
        <div class="dossier-title-group">
          <div class="dossier-avatar-badge">${initials}</div>
          <div>
            <div class="dossier-tag-row">
              <span class="dossier-id-tag mono">${cid}</span>
              <span class="status-indicator-badge live">
                <span class="pulse-dot-emerald"></span> Live EWS Telemetry
              </span>
              <span class="badge ${riskMeta.badgeClass}">${category.toUpperCase()} RISK</span>
            </div>
            <h1 class="dossier-heading">
              Institutional Risk Dossier — <span class="gold-gradient-text">${cid}</span>
            </h1>
          </div>
        </div>
        <div class="dossier-header-actions">
          <a href="/watchlist" class="btn btn-glass">
            <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Back to Watchlist
          </a>
          <button id="copyIdBtn" class="btn btn-glass" title="Copy Customer ID">
            <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path></svg>
            <span id="copyIdText">Copy ID</span>
          </button>
        </div>
      </div>`;

    // 2. Left Column: Radial SVG Gauge & Demographics Profile
    const leftColumnHtml = `
      <div class="dossier-panel dossier-gauge-card">
        <div class="gauge-glow-ambient" style="background:${riskMeta.color}"></div>
        
        <div class="radial-gauge-container">
          <svg class="radial-gauge-svg" viewBox="0 0 200 200">
            <defs>
              <linearGradient id="gaugeGradCritical" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#FF5C5C"/>
                <stop offset="100%" stop-color="#DC2626"/>
              </linearGradient>
              <linearGradient id="gaugeGradHigh" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#FFA14A"/>
                <stop offset="100%" stop-color="#EA580C"/>
              </linearGradient>
              <linearGradient id="gaugeGradMedium" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#FDE047"/>
                <stop offset="100%" stop-color="#CA8A04"/>
              </linearGradient>
              <linearGradient id="gaugeGradLow" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#34D399"/>
                <stop offset="100%" stop-color="#059669"/>
              </linearGradient>
            </defs>
            <!-- Background Circular Track -->
            <circle cx="100" cy="100" r="82" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="14" stroke-linecap="round"/>
            <!-- Active Score Bar -->
            <circle cx="100" cy="100" r="82" fill="none" 
              stroke="url(#${riskMeta.gradId})" 
              stroke-width="14" 
              stroke-linecap="round"
              stroke-dasharray="${circumference}"
              stroke-dashoffset="${dashOffset}"
              style="filter: drop-shadow(0 0 10px ${riskMeta.glowColor}); transition: stroke-dashoffset 1.4s cubic-bezier(0.16,1,0.3,1);"/>
          </svg>

          <div class="gauge-center-content">
            <span class="gauge-center-label">Early Warning Score</span>
            <span class="gauge-center-num" style="color:${riskMeta.color}; text-shadow:0 0 20px ${riskMeta.glowColor}">${score.toFixed(1)}</span>
            <span class="gauge-center-scale">out of 100</span>
          </div>
        </div>

        <div class="gauge-risk-pill ${riskMeta.pillClass}">
          <span class="pulse-dot-inner" style="background:${riskMeta.color}"></span>
          ${category} Risk Category
        </div>

        <div class="demographics-wrap">
          <div class="demographics-section-title">Account Demographics</div>
          <div class="demographics-grid">
            <div class="demographic-chip">
              <span class="demographic-chip-label">Customer ID</span>
              <span class="demographic-chip-value mono">${cid}</span>
            </div>
            <div class="demographic-chip">
              <span class="demographic-chip-label">Entity Type</span>
              <span class="demographic-chip-value">${c.customer_type || 'Individual'}</span>
            </div>
            <div class="demographic-chip">
              <span class="demographic-chip-label">Employment</span>
              <span class="demographic-chip-value">${c.employment_category || 'Salaried'}</span>
            </div>
            <div class="demographic-chip">
              <span class="demographic-chip-label">Portfolio Segment</span>
              <span class="demographic-chip-value">${c.portfolio_segment || 'Retail'}</span>
            </div>
            <div class="demographic-chip">
              <span class="demographic-chip-label">Sanctioned Limit</span>
              <span class="demographic-chip-value mono">${formatCurrency(totalSanctioned)}</span>
            </div>
            <div class="demographic-chip">
              <span class="demographic-chip-label">Outstanding Bal</span>
              <span class="demographic-chip-value mono" style="color:#FB923C">${formatCurrency(totalOutstanding)}</span>
            </div>
          </div>
        </div>
      </div>`;

    // 3. Right Column: Warning Indicators Matrix & Rule Scores
    const warningSignalsHtml = `
      <div class="dossier-panel warning-signals-panel">
        <div class="panel-header-row">
          <div class="panel-title-group">
            <span class="panel-eyebrow">Behavioral Delinquency Signals</span>
            <h2 class="panel-title">Active Warning Indicators</h2>
          </div>
          <span class="panel-count-pill">${indicators.length} Signals Active</span>
        </div>

        <div class="warning-cards-list">
          ${indicators.length > 0 ? indicators.map(ind => `
            <div class="warning-signal-card ${ind.type}">
              <div class="warning-icon-box ${ind.type}">${ind.icon}</div>
              <div class="warning-card-body">
                <span class="warning-card-tag">${ind.tag}</span>
                <div class="warning-card-text">${ind.formatted}</div>
              </div>
            </div>
          `).join('') : `
            <div style="padding:2rem;text-align:center;color:var(--white-50);">
              <div style="font-size:2rem;margin-bottom:0.5rem;">✅</div>
              <div style="font-weight:600;color:var(--white);">Zero Early Warning Flags</div>
              <p style="font-size:0.8rem;margin:0.25rem 0 0;">Customer demonstrates regular repayment hygiene with no active delinquency triggers.</p>
            </div>
          `}
        </div>
      </div>`;

    const ruleScoresHtml = latest ? `
      <div class="rule-scores-grid">
        <!-- Delay Score -->
        <div class="rule-score-card">
          <div class="rule-score-top">
            <span class="rule-score-name">Delay Velocity</span>
            <span style="font-size:1rem;">⚡</span>
          </div>
          <div>
            <div class="rule-score-val-row">
              <span class="rule-score-number" style="color:${(latest.rule_delay_score||0) > 50 ? '#F87171' : '#34D399'}">${(latest.rule_delay_score||0).toFixed(0)}</span>
              <span class="rule-score-denom">/ 100</span>
            </div>
            <div class="rule-progress-track">
              <div class="rule-progress-bar" style="width:${Math.min(100, latest.rule_delay_score||0)}%; background:linear-gradient(90deg, #F59E0B, #EF4444);"></div>
            </div>
            <div class="rule-score-desc">Payment friction & delay frequency in last 3-6 months</div>
          </div>
        </div>

        <!-- Miss Score -->
        <div class="rule-score-card">
          <div class="rule-score-top">
            <span class="rule-score-name">Miss Streak</span>
            <span style="font-size:1rem;">⛔</span>
          </div>
          <div>
            <div class="rule-score-val-row">
              <span class="rule-score-number" style="color:${(latest.rule_miss_score||0) > 50 ? '#FB923C' : '#34D399'}">${(latest.rule_miss_score||0).toFixed(0)}</span>
              <span class="rule-score-denom">/ 100</span>
            </div>
            <div class="rule-progress-track">
              <div class="rule-progress-bar" style="width:${Math.min(100, latest.rule_miss_score||0)}%; background:linear-gradient(90deg, #F97316, #DC2626);"></div>
            </div>
            <div class="rule-score-desc">Consecutive unrecovered missed instalment streak</div>
          </div>
        </div>

        <!-- Exposure Score -->
        <div class="rule-score-card">
          <div class="rule-score-top">
            <span class="rule-score-name">Exposure Weight</span>
            <span style="font-size:1rem;">💼</span>
          </div>
          <div>
            <div class="rule-score-val-row">
              <span class="rule-score-number">${(latest.rule_exposure_score||0).toFixed(0)}</span>
              <span class="rule-score-denom">/ 100</span>
            </div>
            <div class="rule-progress-track">
              <div class="rule-progress-bar" style="width:${Math.min(100, latest.rule_exposure_score||0)}%; background:linear-gradient(90deg, #10B981, #38BDF8);"></div>
            </div>
            <div class="rule-score-desc">Outstanding balance magnitude vs sanction capacity</div>
          </div>
        </div>

        <!-- Data Quality Score -->
        <div class="rule-score-card">
          <div class="rule-score-top">
            <span class="rule-score-name">Data Hygiene</span>
            <span style="font-size:1rem;">📊</span>
          </div>
          <div>
            <div class="rule-score-val-row">
              <span class="rule-score-number" style="color:${(latest.rule_completeness_score||0) < 70 ? '#FBBF24' : '#34D399'}">${(latest.rule_completeness_score||0).toFixed(0)}</span>
              <span class="rule-score-denom">/ 100</span>
            </div>
            <div class="rule-progress-track">
              <div class="rule-progress-bar" style="width:${Math.min(100, latest.rule_completeness_score||0)}%; background:linear-gradient(90deg, #FBBF24, #10B981);"></div>
            </div>
            <div class="rule-score-desc">Income disclosure & bureau repayment history coverage</div>
          </div>
        </div>
      </div>` : '';

    const heroGridHtml = `
      <div class="dossier-grid">
        ${leftColumnHtml}
        <div>
          ${warningSignalsHtml}
          ${ruleScoresHtml}
        </div>
      </div>`;

    // 4. AI Copilot Panel
    const aiHtml = `
      <div class="dossier-panel ai-copilot-panel">
        <div class="ai-copilot-header">
          <div>
            <div class="ai-badge-row">
              <span class="ai-engine-chip">
                <span>✦</span> CREDX NEURAL COPILOT
              </span>
              <span style="font-size:0.75rem; color:var(--white-40); font-family:var(--font-mono);">DeepSeek & GPT-4o Reasoning</span>
            </div>
            <h3 class="ai-copilot-title">Autonomous Risk Synthesis & Advisory</h3>
            <p class="ai-copilot-subtitle">Generative model reasoning synthesizing behavioral delinquency indicators, recovery probability, and mitigating policy actions.</p>
          </div>
          <button id="explainBtn" class="btn btn-gold">
            <span class="btn-sparkle-icon">✨</span>
            <span>Synthesize AI Risk Narrative</span>
          </button>
        </div>

        <div id="aiExplanation" class="ai-explanation-box">
          <div class="ai-placeholder-content">
            <span class="ai-placeholder-icon">🤖</span>
            <div>
              <strong style="color:var(--white);display:block;margin-bottom:0.2rem;">Ready for Natural Language Risk Synthesis</strong>
              <span>Click the button above to evaluate multi-factor repayment signals, compute default trajectory, and draft proactive workout recommendations.</span>
            </div>
          </div>
        </div>
      </div>`;

    // 5. Alert Classification & Supervisory Triage Console
    const assessmentId = latest ? latest.id : null;
    const triageHtml = `
      <div class="dossier-panel triage-console-panel">
        <div class="panel-header-row">
          <div class="panel-title-group">
            <span class="panel-eyebrow">Risk Officer Action Console</span>
            <h3 class="panel-title">Supervisory Alert Disposition & Audit Trail</h3>
          </div>
          <span style="font-size:0.75rem;color:var(--white-40);font-family:var(--font-mono);">Regulatory Audit Log • ISO 27001 Compliant</span>
        </div>

        <p style="font-size:0.85rem;color:var(--white-60);margin-bottom:1.25rem;">
          Select a supervisory triage determination and record justification notes for regulatory audit and portfolio governance.
        </p>

        <div class="triage-decisions-grid">
          <button type="button" class="triage-btn" data-decision="Continue Monitoring">
            <span class="triage-btn-icon">👁️</span>
            <span class="triage-btn-label">Continue Monitoring</span>
            <span class="triage-btn-sub">Passive surveillance cycle</span>
          </button>
          <button type="button" class="triage-btn" data-decision="Requires Investigation">
            <span class="triage-btn-icon">🔍</span>
            <span class="triage-btn-label">Requires Investigation</span>
            <span class="triage-btn-sub">Direct borrower outreach</span>
          </button>
          <button type="button" class="triage-btn" data-decision="False Positive">
            <span class="triage-btn-icon">🛡️</span>
            <span class="triage-btn-label">False Positive</span>
            <span class="triage-btn-sub">Technical or mandate noise</span>
          </button>
          <button type="button" class="triage-btn" data-decision="Escalate for Review">
            <span class="triage-btn-icon">🚨</span>
            <span class="triage-btn-label">Escalate for Review</span>
            <span class="triage-btn-sub">Credit Committee referral</span>
          </button>
        </div>

        <div class="triage-preset-chips">
          <span class="preset-chip-label">Quick Presets:</span>
          <button type="button" class="preset-chip" data-preset="Salary credit delayed by employer; borrower confirmed transfer date.">+ Employer payroll lag</button>
          <button type="button" class="preset-chip" data-preset="Borrower contacted via phone; confirmed settlement promise within 5 business days.">+ Promise to pay logged</button>
          <button type="button" class="preset-chip" data-preset="Mandate bounce due to technical bank clearing failure. Non-credit cause.">+ Clearing failure</button>
          <button type="button" class="preset-chip" data-preset="Unresponsive to multi-channel outreach; initiate field recovery team.">+ Escalated to field team</button>
        </div>

        <textarea id="alertReason" class="triage-textarea" placeholder="Detail supervisory rationale, borrower communications, or remedial directives…"></textarea>

        <div class="triage-actions-bar">
          <span class="triage-officer-stamp">
            Officer: <strong style="color:var(--white-75);">Sreesh K Suresh (Risk Surveillance)</strong> • Timestamp will be recorded automatically
          </span>
          <button id="submitAlert" class="btn btn-gold" disabled>
            <span>Commit Disposition</span>
          </button>
        </div>
        <input type="hidden" id="assessmentId" value="${assessmentId || ''}" />
      </div>`;

    // 6. Loan Facilities Table
    const loansHtml = loans.length > 0 ? `
      <div class="dossier-panel dossier-facilities-panel">
        <div class="panel-header-row">
          <div class="panel-title-group">
            <span class="panel-eyebrow">Credit Facilities</span>
            <h3 class="panel-title">Sanctioned Loan Facilities (${loans.length})</h3>
          </div>
          <span style="font-size:0.8rem;color:var(--white-60);font-family:var(--font-mono);">Active Exposure: <strong style="color:#FB923C;">${formatCurrency(totalOutstanding)}</strong></span>
        </div>

        <div class="table-scroll-frame">
          <table class="luxury-data-table">
            <thead>
              <tr>
                <th>Loan Facility ID</th>
                <th>Product Type</th>
                <th>Sanctioned Amount</th>
                <th>Outstanding Balance</th>
                <th>Exposure Utilization</th>
                <th>Monthly EMI</th>
                <th>Tenure</th>
                <th>Facility Status</th>
              </tr>
            </thead>
            <tbody>
              ${loans.map(l => {
                const sAmt = l.sanctioned_amount || 0;
                const oBal = l.outstanding_balance || 0;
                const pct = sAmt > 0 ? Math.min(100, Math.round((oBal / sAmt) * 100)) : 0;
                return `
                  <tr>
                    <td class="mono" style="font-weight:700;color:var(--gold-400);">${l.loan_id}</td>
                    <td style="text-transform:capitalize;font-weight:600;">${(l.product_type || 'Loan').replace(/_/g, ' ')}</td>
                    <td class="mono">${formatCurrency(sAmt)}</td>
                    <td class="mono" style="font-weight:700;color:#FB923C;">${formatCurrency(oBal)}</td>
                    <td>
                      <div class="loan-util-wrap">
                        <div class="loan-util-bar-track">
                          <div class="loan-util-bar-fill" style="width:${pct}%;"></div>
                        </div>
                        <span class="loan-util-label">${pct}% of limit</span>
                      </div>
                    </td>
                    <td class="mono">${formatCurrency(l.instalment_amount)}</td>
                    <td class="mono">${l.tenure_months || '—'} mo</td>
                    <td>
                      <span class="badge ${l.status === 'active' ? 'badge-low' : 'badge-medium'}">
                        ${l.status || 'Active'}
                      </span>
                    </td>
                  </tr>`;
              }).join('')}
            </tbody>
          </table>
        </div>
      </div>` : '';

    // 7. Repayment Ledger
    const repHtml = repayments.length > 0 ? `
      <div class="dossier-panel dossier-repayments-panel">
        <div class="panel-header-row">
          <div class="panel-title-group">
            <span class="panel-eyebrow">Payment Surveillance Ledger</span>
            <h3 class="panel-title">Repayment History Records (${repayments.length})</h3>
          </div>
          <span style="font-size:0.75rem;color:var(--white-40);font-family:var(--font-mono);">Sorted Chronologically</span>
        </div>

        <div class="repayment-table-frame">
          <table class="luxury-data-table">
            <thead>
              <tr>
                <th>Scheduled Due Date</th>
                <th>Settlement Date</th>
                <th>Amount Due</th>
                <th>Amount Paid</th>
                <th>Days Past Due (DPD)</th>
                <th>Repayment Status</th>
              </tr>
            </thead>
            <tbody>
              ${repayments.map(r => {
                const status = (r.repayment_status || 'unknown').toLowerCase();
                const dpd = r.dpd || 0;
                let dpdClass = 'dpd-0';
                if (dpd > 30) dpdClass = 'dpd-danger';
                else if (dpd > 0) dpdClass = 'dpd-warning';

                return `
                  <tr>
                    <td class="mono" style="font-weight:600;">${r.due_date || '—'}</td>
                    <td class="mono" style="color:var(--white-60);">${r.payment_date || '—'}</td>
                    <td class="mono">${formatCurrency(r.amount_due)}</td>
                    <td class="mono" style="font-weight:600;color:${status === 'missed' ? '#F87171' : 'var(--white)'};">${formatCurrency(r.amount_paid)}</td>
                    <td>
                      <span class="dpd-badge ${dpdClass}">${dpd} DPD</span>
                    </td>
                    <td>
                      <span class="repay-status-pill ${status}">
                        ${status.replace(/_/g, ' ')}
                      </span>
                    </td>
                  </tr>`;
              }).join('')}
            </tbody>
          </table>
        </div>
      </div>` : '';

    // 8. Historical Supervisory Decisions
    const alertsHistHtml = alerts.length > 0 ? `
      <div class="dossier-panel dossier-audit-panel">
        <div class="panel-header-row">
          <div class="panel-title-group">
            <span class="panel-eyebrow">Compliance Audit</span>
            <h3 class="panel-title">Past Alert Triage Decisions (${alerts.length})</h3>
          </div>
        </div>

        <div class="table-scroll-frame">
          <table class="luxury-data-table">
            <thead>
              <tr>
                <th>Supervisory Disposition</th>
                <th>Rationale & Audit Notes</th>
                <th>Score at Triage</th>
                <th>Officer ID</th>
                <th>Logged Date</th>
              </tr>
            </thead>
            <tbody>
              ${alerts.map(a => `
                <tr>
                  <td><span class="badge badge-medium">${a.decision}</span></td>
                  <td style="color:var(--white-80);max-width:320px;">${a.reason || '—'}</td>
                  <td class="mono" style="font-weight:700;">${a.original_score?.toFixed(1) || '—'}</td>
                  <td class="mono" style="color:var(--white-60);">${a.analyst_id || 'analyst-1'}</td>
                  <td class="mono" style="color:var(--white-40);">${a.created_at ? new Date(a.created_at * 1000).toLocaleString() : '—'}</td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      </div>` : '';

    // Assemble page
    container.innerHTML = headerHtml + heroGridHtml + aiHtml + triageHtml + loansHtml + repHtml + alertsHistHtml;

    // Attach Copy ID button
    const copyBtn = document.getElementById('copyIdBtn');
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(cid).then(() => {
          const txt = document.getElementById('copyIdText');
          if (txt) {
            txt.textContent = 'Copied!';
            setTimeout(() => { txt.textContent = 'Copy ID'; }, 2000);
          }
        });
      });
    }

    // Attach AI Explanation synthesis
    const explainBtn = document.getElementById('explainBtn');
    if (explainBtn) {
      explainBtn.addEventListener('click', async () => {
        const out = document.getElementById('aiExplanation');
        explainBtn.disabled = true;
        explainBtn.innerHTML = `<span class="pulse-dot" style="display:inline-block;margin-right:6px;"></span> Generating Inference…`;
        out.innerHTML = `
          <div style="padding:1.5rem;text-align:center;color:var(--gold-400);">
            <div class="pulse-dot" style="margin:0 auto 0.75rem;width:10px;height:10px;"></div>
            <span>Evaluating multi-dimensional delinquency signals via CredX Copilot…</span>
          </div>`;

        try {
          const res = await fetch(`${API}/explain/${cid}`, { method: 'POST' });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const result = await res.json();

          let html = `<div class="ai-narrative-text">${result.explanation || 'No narrative explanation was synthesized.'}</div>`;

          if (result.risk_factors && result.risk_factors.length) {
            html += `<div class="ai-section-title"><span>⚠️</span> Primary Risk Contributors</div>`;
            html += `<div class="ai-factors-grid">${result.risk_factors.map(f => `<div class="ai-factor-pill">${f}</div>`).join('')}</div>`;
          }

          if (result.recommended_actions && result.recommended_actions.length) {
            html += `<div class="ai-section-title"><span>📋</span> Recommended Remediation Directives</div>`;
            html += `<div class="ai-actions-list">${result.recommended_actions.map(a => `
              <div class="ai-action-item">
                <span class="ai-action-icon">✓</span>
                <span>${a}</span>
              </div>
            `).join('')}</div>`;
          }

          out.innerHTML = html;
        } catch (err) {
          out.innerHTML = `
            <div style="color:#F87171;padding:0.5rem 0;">
              <strong>Synthesis Error:</strong> ${err.message}
            </div>`;
        }
        explainBtn.disabled = false;
        explainBtn.innerHTML = `<span class="btn-sparkle-icon">✨</span><span>Re-Synthesize Narrative</span>`;
      });
    }

    // Attach Preset Chips to Textarea
    const reasonTextarea = document.getElementById('alertReason');
    document.querySelectorAll('.preset-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        const text = chip.dataset.preset;
        if (reasonTextarea) {
          if (reasonTextarea.value.trim().length > 0) {
            reasonTextarea.value += ' ' + text;
          } else {
            reasonTextarea.value = text;
          }
          reasonTextarea.focus();
        }
      });
    });

    // Attach Triage Buttons
    let selectedDecision = null;
    const submitBtn = document.getElementById('submitAlert');

    document.querySelectorAll('.triage-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.triage-btn').forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
        selectedDecision = btn.dataset.decision;
        if (submitBtn) submitBtn.disabled = false;
      });
    });

    if (submitBtn) {
      submitBtn.addEventListener('click', async () => {
        const aId = document.getElementById('assessmentId').value;
        const reason = reasonTextarea ? reasonTextarea.value : '';
        if (!aId || !selectedDecision) return;

        submitBtn.disabled = true;
        submitBtn.innerHTML = `<span>⏳ Committing…</span>`;

        try {
          const res = await fetch(`${API}/alert/${aId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              decision: selectedDecision,
              reason: reason || `Officer selected ${selectedDecision}`,
              analyst_id: 'Sreesh K Suresh (Surveillance)',
            }),
          });
          if (!res.ok) {
            const err = await res.json();
            throw new Error(err.detail || `HTTP ${res.status}`);
          }
          submitBtn.innerHTML = `<span>✓ Disposition Committed</span>`;
          setTimeout(() => loadCustomer(), 1200);
        } catch (err) {
          submitBtn.innerHTML = `<span>✗ ${err.message}</span>`;
          setTimeout(() => {
            submitBtn.disabled = false;
            submitBtn.innerHTML = `<span>Commit Disposition</span>`;
          }, 3000);
        }
      });
    }
  }

  loadCustomer();
</script>
