---
import Layout from "../../layouts/Layout.astro";
import DashboardNav from "../../components/dashboard/DashboardNav.astro";
import ScoreMethodology from "../../components/dashboard/ScoreMethodology.astro";

const { id } = Astro.params;
---

<Layout title={`CredX — Customer ${id}`}>
  <div class="dash-layout">
    <DashboardNav />
    <main class="dash-main">
      <div class="dash-header">
        <h1>Customer <span id="custTitle">{id}</span></h1>
        <a href="/watchlist" class="btn btn-ghost">← Back to Watchlist</a>
      </div>
      <div id="customerContent">
        <div class="loading">Loading customer data…</div>
      </div>
      <ScoreMethodology />
    </main>
  </div>
</Layout>

<script define:vars={{ id }}>
  const API = '/api/v1/ews';
  const customerId = id;

  async function loadCustomer() {
    const container = document.getElementById('customerContent');
    try {
      const res = await fetch(`${API}/customer/${customerId}`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      renderCustomer(data, container);
    } catch (err) {
      container.innerHTML = `<div class="empty-state">Error loading customer: ${err.message}</div>`;
    }
  }

  const INSUFFICIENT = 'Insufficient Data';
  const esc = (v) => String(v ?? '').replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
  const badgeClass = (cat) => cat === INSUFFICIENT ? 'badge-insufficient' : `badge-${String(cat).toLowerCase()}`;

  const RULE_NOTE = ' Shown to explain the signal; the final score comes from the warning-score model, which reads the same data directly.';
  const TIPS = {
    delay: 'How late does the customer pay, and is it getting worse? A late payment is an instalment paid after its due date. Rule 1 (0–100, higher = worse). Late-payment ratio up to 30 pts, max days past due up to 20, consecutive late payments up to 15, average days late, DPD trend and partial payments up to 10 each, 12-month context up to 5.' + RULE_NOTE,
    miss: 'Are the misses a one-off or a lasting problem? A miss is any instalment not paid in full and on time: late, unpaid, or only partly paid. A recovery is a miss followed by a full, on-time payment. Rule 2 (0–100, higher = worse). Recovery rate up to 30 pts, longest late streak up to 25, miss frequency up to 15, recency and clustering up to 10 each, minus up to 10 for holiday or month-end delays. Below 25 = temporary, 25–50 = inconclusive, above 50 = sustained.' + RULE_NOTE,
    exposure: 'How much debt is the customer carrying, and can they afford it? Utilisation = amount owed ÷ amount sanctioned. Rule 3 (0–100, higher = worse). Utilisation up to 25 pts, card or overdraft utilisation up to 20, active loans and debt-to-income up to 15 each, new loans in 3 months and balance trend up to 10 each. Needs uploaded exposure data.' + RULE_NOTE,
    cashflow: 'Is the money coming into the customer\'s account falling? Model 1 (0–100) = probability × 100 that monthly inflow is in sustained decline. Gradient boosting (scikit-learn, 200 trees) on 12 trend features, trained on synthetic cash flows for all 307,511 Home Credit applicants (test AUC 0.888). Needs at least 3 months. 25% of the final score.',
    quality: 'Do we have enough data to judge this customer? Rule 4 (0–100, higher = more complete, not a risk score). Repayment records up to 35 pts, loan and credit-limit data up to 20, months of history up to 15, income and DPD fields, freshness and coverage up to 10 each. Below 50, or fewer than 6 months of instalments, the customer is tagged Insufficient Data.',
    score: 'Final = 0.75 × model score + 0.25 × cash-flow score (model score alone if under 3 months of cash flow). The model score comes from an XGBoost model trained on all 307,511 Home Credit customers (test AUC 0.678): predicted default probability ÷ 8.07% baseline, mapped to Low < 20, Medium 20–45, High 45–70, Critical ≥ 70.',
  };
  const notEvaluated = '<span style="color:var(--text-muted);font-size:0.875rem;">Not evaluated</span>';
  const tip = (key) => `<span class="info-tip" tabindex="0" role="img" aria-label="${esc(TIPS[key])}" title="${esc(TIPS[key])}">i</span>`;

  function gaugeColor(score) {
    if (score < 20) return '#22C55E';
    if (score < 45) return '#F59E0B';
    if (score < 70) return '#F97316';
    return '#EF4444';
  }

  function renderCustomer(data, container) {
    const c = data.customer || {};
    const assessments = data.assessments || [];
    // The API returns assessments newest first.
    const latest = assessments.length > 0 ? assessments[0] : null;
    const score = latest ? latest.warning_score : 0;
    const category = latest ? latest.risk_category : 'N/A';
    const insufficient = category === INSUFFICIENT;
    const color = insufficient ? '#94A3B8' : gaugeColor(score);
    const deg = (score / 100) * 360;

    const loans = data.loans || [];
    const repayments = data.repayments || [];
    const alerts = data.alerts || [];

    const indicators = latest ? (typeof latest.top_indicators === 'string' ? JSON.parse(latest.top_indicators) : latest.top_indicators) || [] : [];

    // Profile + Score
    const profileHtml = `
      <div class="detail-grid">
        <div class="profile-card">
          <div class="score-gauge" style="background:conic-gradient(${color} ${deg}deg, var(--border-subtle) ${deg}deg)">
            <div class="score-gauge-inner">
              <div class="score-gauge-value ${insufficient ? 'score-blur' : ''}" style="color:${color}" ${insufficient ? 'aria-hidden="true"' : ''}>${score.toFixed(0)}</div>
              <div class="score-gauge-label">${insufficient ? 'Provisional score' : 'Warning Score'} ${tip('score')}</div>
            </div>
          </div>
          <div style="text-align:center;margin-bottom:1rem;">
            <span class="badge ${badgeClass(category)}" style="font-size:0.8rem;">${esc(category)}</span>
            ${insufficient ? `<div class="thin-file-note">
              <strong>Not enough data to rate this customer.</strong> The risk is unknown, not low. The
              score is provisional and should not drive decisions until more repayment history and
              income evidence are on file.
            </div>` : ''}
          </div>
          <dl>
            <div class="profile-card-field"><dt>Customer ID</dt><dd>${c.customer_id || customerId}</dd></div>
            <div class="profile-card-field"><dt>Type</dt><dd>${c.customer_type || '—'}</dd></div>
            <div class="profile-card-field"><dt>Employment</dt><dd>${c.employment_category || '—'}</dd></div>
            <div class="profile-card-field"><dt>Segment</dt><dd>${c.portfolio_segment || '—'}</dd></div>
          </dl>
        </div>
        <div>
          <!-- Indicators -->
          <div class="data-table-wrap" style="margin-bottom:1rem;">
            <h3>Warning Indicators</h3>
            <div style="padding:1rem;">
              ${indicators.length > 0 ? `<ul class="ai-factors">${indicators.map(i => `<li>${esc(i)}</li>`).join('')}</ul>` : '<div style="color:var(--text-muted);font-size:0.8125rem;">No active warning indicators</div>'}
            </div>
          </div>

          <!-- Rule Scores -->
          ${latest ? `
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:0.75rem;margin-bottom:1rem;">
            <div class="stat-card"><div class="stat-card-label">Delay Score ${tip('delay')}</div><div class="stat-card-value" style="font-size:1.25rem;">${(latest.rule_delay_score||0).toFixed(0)}</div></div>
            <div class="stat-card"><div class="stat-card-label">Miss Pattern ${tip('miss')}</div><div class="stat-card-value" style="font-size:1.25rem;">${(latest.rule_miss_score||0).toFixed(0)}</div></div>
            <div class="stat-card"><div class="stat-card-label">Exposure Score ${tip('exposure')}</div><div class="stat-card-value" style="font-size:1.25rem;">${latest.rule_exposure_score ? latest.rule_exposure_score.toFixed(0) : notEvaluated}</div></div>
            <div class="stat-card"><div class="stat-card-label">Cash Flow ${tip('cashflow')}</div><div class="stat-card-value" style="font-size:1.25rem;">${latest.cashflow_score ? latest.cashflow_score.toFixed(0) : notEvaluated}</div></div>
            <div class="stat-card"><div class="stat-card-label">Data Quality ${tip('quality')}</div><div class="stat-card-value" style="font-size:1.25rem;">${(latest.rule_completeness_score||0).toFixed(0)}</div></div>
          </div>` : ''}
        </div>
      </div>`;

    // AI Explanation
    const aiHtml = `
      <div class="ai-section">
        <h3>✦ AI Risk Explanation</h3>
        <div id="aiExplanation" style="color:var(--text-muted);font-size:0.8125rem;">Click below to generate an AI-powered explanation of this customer's risk.</div>
        <button id="explainBtn" class="btn btn-primary" style="margin-top:0.75rem;">🤖 Get AI Explanation</button>
      </div>`;

    // Alert Classification
    const assessmentId = latest ? latest.id : null;
    const alertHtml = `
      <div class="alert-panel">
        <h3>Classify Alert</h3>
        <div class="alert-buttons">
          <button class="alert-btn" data-decision="Continue Monitoring">Continue Monitoring</button>
          <button class="alert-btn" data-decision="Requires Investigation">Requires Investigation</button>
          <button class="alert-btn" data-decision="False Positive">False Positive</button>
          <button class="alert-btn" data-decision="Escalate for Review">Escalate for Review</button>
        </div>
        <div class="form-group">
          <label class="form-label">Reason</label>
          <textarea id="alertReason" class="form-textarea" placeholder="Provide a reason for the classification…"></textarea>
        </div>
        <button id="submitAlert" class="btn btn-primary" disabled>Submit Classification</button>
        <input type="hidden" id="assessmentId" value="${assessmentId || ''}" />
      </div>`;

    // Loans table
    const loansHtml = loans.length > 0 ? `
      <div class="data-table-wrap">
        <h3>Loan Facilities (${loans.length})</h3>
        <table class="data-table">
          <thead><tr><th>Loan ID</th><th>Product</th><th>Sanctioned</th><th>Outstanding</th><th>Instalment</th><th>Tenure</th></tr></thead>
          <tbody>${loans.map(l => `<tr>
            <td class="mono">${l.loan_id}</td>
            <td>${l.product_type || '—'}</td>
            <td class="mono">₹${(l.sanctioned_amount||0).toLocaleString()}</td>
            <td class="mono">₹${(l.outstanding_balance||0).toLocaleString()}</td>
            <td class="mono">₹${(l.instalment_amount||0).toLocaleString()}</td>
            <td>${l.tenure_months || '—'} mo</td>
          </tr>`).join('')}</tbody>
        </table>
      </div>` : '';

    // Repayments table
    const repHtml = repayments.length > 0 ? `
      <div class="data-table-wrap">
        <h3>Repayment History (${repayments.length})</h3>
        <table class="data-table">
          <thead><tr><th>Due Date</th><th>Payment Date</th><th>Due</th><th>Paid</th><th>DPD</th><th>Status</th></tr></thead>
          <tbody>${repayments.map(r => {
            const status = r.repayment_status || 'unknown';
            return `<tr>
              <td class="mono">${r.due_date || '—'}</td>
              <td class="mono">${r.payment_date || '—'}</td>
              <td class="mono">₹${(r.amount_due||0).toLocaleString()}</td>
              <td class="mono">₹${(r.amount_paid||0).toLocaleString()}</td>
              <td class="mono">${r.dpd || 0}</td>
              <td><span class="status-${status}">${status}</span></td>
            </tr>`;
          }).join('')}</tbody>
        </table>
      </div>` : '';

    // Past alerts
    const alertsHistHtml = alerts.length > 0 ? `
      <div class="data-table-wrap">
        <h3>Past Alert Decisions (${alerts.length})</h3>
        <table class="data-table">
          <thead><tr><th>Decision</th><th>Reason</th><th>Original Score</th><th>Analyst</th><th>Date</th></tr></thead>
          <tbody>${alerts.map(a => `<tr>
            <td><span class="badge badge-medium">${a.decision}</span></td>
            <td>${esc(a.reason) || '—'}</td>
            <td class="mono">${a.original_score?.toFixed(1) || '—'}</td>
            <td>${a.analyst_id || '—'}</td>
            <td class="mono">${a.created_at ? new Date(a.created_at * 1000).toLocaleDateString() : '—'}</td>
          </tr>`).join('')}</tbody>
        </table>
      </div>` : '';

    container.innerHTML = profileHtml + aiHtml + alertHtml + loansHtml + repHtml + alertsHistHtml;

    // Wire up AI explanation
    document.getElementById('explainBtn').addEventListener('click', async () => {
      const btn = document.getElementById('explainBtn');
      const out = document.getElementById('aiExplanation');
      btn.disabled = true;
      btn.textContent = '⏳ Generating…';
      out.textContent = 'Calling AI model…';

      try {
        const res = await fetch(`${API}/explain/${customerId}`, { method: 'POST' });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const result = await res.json();

        const heading = (t) => `<h4 style="margin-top:0.75rem;font-size:0.75rem;color:var(--gold-500);text-transform:uppercase;letter-spacing:0.05em;">${t}</h4>`;
        let html = '';
        if (result.data_status === 'insufficient') {
          html += `<span class="badge badge-insufficient" style="margin-bottom:0.5rem;">Unknown risk: thin file</span>`;
        }
        html += `<p class="ai-explanation">${esc(result.explanation || 'No explanation generated.')}</p>`;
        if (result.risk_factors && result.risk_factors.length) {
          html += heading(result.data_status === 'insufficient' ? 'Data Gaps' : 'Risk Factors');
          html += `<ul class="ai-factors">${result.risk_factors.map(f => `<li>${esc(f)}</li>`).join('')}</ul>`;
        }
        if (result.recommended_actions && result.recommended_actions.length) {
          html += heading('Recommended Actions');
          html += `<ul class="ai-factors">${result.recommended_actions.map(a => `<li>${esc(a)}</li>`).join('')}</ul>`;
        }
        html += `<div class="ai-meta">${result.source === 'ai'
          ? `Generated by ${esc(result.model)}. It explains the score and does not change it.`
          : 'AI unavailable: showing the rule-based explanation.'}</div>`;
        out.innerHTML = html;
      } catch (err) {
        out.textContent = `Error: ${err.message}`;
      }
      btn.disabled = false;
      btn.textContent = '🤖 Get AI Explanation';
    });

    // Wire up alert classification
    let selectedDecision = null;
    document.querySelectorAll('.alert-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.alert-btn').forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
        selectedDecision = btn.dataset.decision;
        document.getElementById('submitAlert').disabled = false;
      });
    });

    document.getElementById('submitAlert').addEventListener('click', async () => {
      const aId = document.getElementById('assessmentId').value;
      const reason = document.getElementById('alertReason').value;
      if (!aId || !selectedDecision) return;

      const submitBtn = document.getElementById('submitAlert');
      submitBtn.disabled = true;
      submitBtn.textContent = '⏳ Submitting…';

      try {
        const res = await fetch(`${API}/alert/${aId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ decision: selectedDecision, reason, analyst_id: 'analyst-1' }),
        });
        if (!res.ok) {
          const err = await res.json();
          throw new Error(err.detail || `HTTP ${res.status}`);
        }
        submitBtn.textContent = '✓ Submitted';
        setTimeout(() => loadCustomer(), 1000);
      } catch (err) {
        submitBtn.textContent = `✗ ${err.message}`;
      }
      setTimeout(() => {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit Classification';
      }, 3000);
    });
  }

  loadCustomer();
</script>
