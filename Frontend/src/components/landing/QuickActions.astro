---
// Quick Action Shortcuts Grid
---

<section class="quick-actions-bar" aria-label="Banking Actions">
	<button type="button" class="action-tile" id="action-wire">
		<div class="action-icon-box">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<line x1="22" y1="2" x2="11" y2="13"/>
				<polygon points="22 2 15 22 11 13 2 9 22 2"/>
			</svg>
		</div>
		<div>
			<h4 class="action-title">Wire Transfer</h4>
			<p class="action-caption">Instant SWIFT / SEPA</p>
		</div>
	</button>

	<button type="button" class="action-tile" id="action-exchange">
		<div class="action-icon-box">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M16 3h5v5"/>
				<path d="M4 20L21 3"/>
				<path d="M21 16v5h-5"/>
				<path d="M15 15l6 6"/>
				<path d="M4 4l5 5"/>
			</svg>
		</div>
		<div>
			<h4 class="action-title">Convert FX</h4>
			<p class="action-caption">Institutional Spreads</p>
		</div>
	</button>

	<button type="button" class="action-tile" id="action-deposit">
		<div class="action-icon-box">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<rect x="2" y="4" width="20" height="16" rx="2"/>
				<line x1="12" y1="8" x2="12" y2="16"/>
				<line x1="8" y1="12" x2="16" y2="12"/>
			</svg>
		</div>
		<div>
			<h4 class="action-title">Add Funds</h4>
			<p class="action-caption">Direct ACH / FedNow</p>
		</div>
	</button>

	<button type="button" class="action-tile" id="action-virtual">
		<div class="action-icon-box">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<rect x="1" y="4" width="22" height="16" rx="2" stroke-linecap="round"/>
				<line x1="1" y1="10" x2="23" y2="10"/>
			</svg>
		</div>
		<div>
			<h4 class="action-title">Virtual Card</h4>
			<p class="action-caption">Burner Security Token</p>
		</div>
	</button>

	<button type="button" class="action-tile" id="action-statements">
		<div class="action-icon-box">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
				<polyline points="14 2 14 8 20 8"/>
				<line x1="16" y1="13" x2="8" y2="13"/>
				<line x1="16" y1="17" x2="8" y2="17"/>
			</svg>
		</div>
		<div>
			<h4 class="action-title">Statements</h4>
			<p class="action-caption">Tax & Monthly Audit</p>
		</div>
	</button>
</section>
