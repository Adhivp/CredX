---
// Financial Insights & Real-time Market Ticker Component
---

<div class="insights-grid">
	<!-- Market Rates Card -->
	<div class="insight-card">
		<div class="insight-card-header">
			<div>
				<h3 class="insight-title">Global Prime Ticker</h3>
				<p class="insight-desc">Real-time institutional liquidity benchmarks</p>
			</div>
			<span class="pulse-indicator">
				<span class="pulse-core"></span>
				Live Feed
			</span>
		</div>

		<div class="ticker-list">
			<div class="ticker-item">
				<div class="ticker-symbol-group">
					<span class="ticker-name">Physical Gold</span>
					<span class="ticker-code">XAU / USD</span>
				</div>
				<div class="ticker-price-group">
					<span class="ticker-price">$2,748.50</span>
					<span class="ticker-gain up">+1.42%</span>
				</div>
			</div>

			<div class="ticker-item">
				<div class="ticker-symbol-group">
					<span class="ticker-name">Euro Spot</span>
					<span class="ticker-code">EUR / USD</span>
				</div>
				<div class="ticker-price-group">
					<span class="ticker-price">1.0884</span>
					<span class="ticker-gain up">+0.32%</span>
				</div>
			</div>

			<div class="ticker-item">
				<div class="ticker-symbol-group">
					<span class="ticker-name">British Pound</span>
					<span class="ticker-code">GBP / USD</span>
				</div>
				<div class="ticker-price-group">
					<span class="ticker-price">1.2985</span>
					<span class="ticker-gain up">+0.19%</span>
				</div>
			</div>

			<div class="ticker-item">
				<div class="ticker-symbol-group">
					<span class="ticker-name">Swiss Franc</span>
					<span class="ticker-code">USD / CHF</span>
				</div>
				<div class="ticker-price-group">
					<span class="ticker-price">0.8648</span>
					<span class="ticker-gain down">-0.08%</span>
				</div>
			</div>
		</div>
	</div>

	<!-- Private Wealth Concierge -->
	<div class="insight-card concierge-card">
		<div class="concierge-header">
			<div class="concierge-avatar">
				<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
					<circle cx="12" cy="7" r="4"/>
				</svg>
			</div>
			<div>
				<span class="concierge-tag">Dedicated Advisor</span>
				<h3 class="concierge-name">Eleanor Vance-Sterling</h3>
				<p class="concierge-title">Executive Director, Private Client Group</p>
			</div>
		</div>

		<p class="concierge-blurb">
			"Your Prime Yield Vault rebalancing is complete. Your funds are protected across tier-1 custodians in Zurich and New York."
		</p>

		<div class="concierge-actions">
			<button type="button" class="btn-concierge-call">
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
				</svg>
				<span>Direct Secure Line</span>
			</button>
			<button type="button" class="btn-concierge-msg">
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
				</svg>
				<span>Message</span>
			</button>
		</div>
	</div>
</div>

<style>
	.insights-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
	}

	.insight-card {
		background: var(--black-900);
		border: 1px solid var(--border-medium);
		border-radius: var(--radius-2xl);
		padding: 2.25rem;
		box-shadow: var(--shadow-card);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}

	.insight-card-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		margin-bottom: 1.5rem;
	}

	.insight-title {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--white);
	}

	.insight-desc {
		font-size: 0.8rem;
		color: var(--white-40);
		margin-top: 0.2rem;
	}

	.pulse-indicator {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.725rem;
		font-weight: 600;
		color: var(--status-success);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.pulse-core {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--status-success);
		box-shadow: 0 0 8px rgba(34, 197, 94, 0.8);
		animation: pulseDot 1.8s infinite;
	}

	.ticker-list {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	.ticker-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.85rem 1rem;
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(255, 255, 255, 0.05);
		border-radius: var(--radius-md);
		transition: background var(--ease-fast);
	}

	.ticker-item:hover {
		background: rgba(255, 255, 255, 0.04);
		border-color: rgba(245, 197, 24, 0.25);
	}

	.ticker-symbol-group {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.ticker-name {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--white);
	}

	.ticker-code {
		font-size: 0.75rem;
		color: var(--white-40);
		font-family: var(--font-mono);
	}

	.ticker-price-group {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.15rem;
	}

	.ticker-price {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.95rem;
		color: var(--white);
	}

	.ticker-gain {
		font-size: 0.75rem;
		font-weight: 700;
	}

	.ticker-gain.up {
		color: var(--status-success);
	}

	.ticker-gain.down {
		color: var(--status-danger);
	}

	/* Concierge */
	.concierge-card {
		background: radial-gradient(circle at 90% 10%, rgba(245, 197, 24, 0.08) 0%, var(--black-900) 60%);
		border: 1px solid var(--border-medium);
	}

	.concierge-header {
		display: flex;
		align-items: center;
		gap: 1.15rem;
		margin-bottom: 1.25rem;
	}

	.concierge-avatar {
		width: 52px;
		height: 52px;
		border-radius: 50%;
		background: linear-gradient(135deg, rgba(245, 197, 24, 0.2), rgba(245, 197, 24, 0.05));
		border: 1px solid var(--border-accent);
		color: var(--gold-500);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.concierge-tag {
		font-size: 0.725rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--gold-500);
		display: block;
		margin-bottom: 0.15rem;
	}

	.concierge-name {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--white);
	}

	.concierge-title {
		font-size: 0.8rem;
		color: var(--white-40);
	}

	.concierge-blurb {
		font-size: 0.9rem;
		color: var(--white-75);
		line-height: 1.6;
		font-style: italic;
		border-left: 2px solid var(--gold-500);
		padding-left: 1rem;
		margin: 1.25rem 0 1.75rem 0;
	}

	.concierge-actions {
		display: flex;
		gap: 0.85rem;
	}

	.btn-concierge-call {
		flex: 1.3;
		padding: 0.8rem 1.25rem;
		background: var(--gold-gradient);
		color: #0A0A0A;
		border-radius: var(--radius-md);
		font-size: 0.85rem;
		font-weight: 700;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		box-shadow: var(--shadow-gold);
		transition: all var(--ease-fast);
	}

	.btn-concierge-call:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-gold-lg);
	}

	.btn-concierge-msg {
		flex: 1;
		padding: 0.8rem 1.25rem;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid var(--border-medium);
		color: var(--white-90);
		border-radius: var(--radius-md);
		font-size: 0.85rem;
		font-weight: 600;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		transition: all var(--ease-fast);
	}

	.btn-concierge-msg:hover {
		background: rgba(255, 255, 255, 0.08);
		border-color: var(--white-20);
	}

	@media (max-width: 900px) {
		.insights-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
