---
// Luxury Metal Card Showcase Component
---

<div class="metal-card-container">
	<!-- 3D Luxury Black & Gold Metal Card -->
	<div class="metal-card" id="metal-card-element">
		<div class="card-top-row">
			<div class="card-chip"></div>
			<div class="card-contactless">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M8.5 16.5a5 5 0 0 1 0-7" stroke-linecap="round"/>
					<path d="M12 19a8.5 8.5 0 0 1 0-12" stroke-linecap="round"/>
					<path d="M15.5 21.5a12 12 0 0 1 0-17" stroke-linecap="round"/>
				</svg>
			</div>
			<div class="card-logo-emblem">
				<img src="/logo.png" alt="CredX Card Emblem" />
			</div>
		</div>

		<div class="card-number" id="card-digits">
			•••• &nbsp;•••• &nbsp;•••• &nbsp;8842
		</div>

		<div class="card-bottom-row">
			<div class="card-holder-info">
				<span class="card-holder-label">Cardholder</span>
				<span class="card-holder-name" id="card-holder-name">Alexander Vance</span>
			</div>
			<div class="card-expiry-info">
				<span class="card-tier-tag">Black Metal</span>
				<span class="card-holder-label">Exp 09/30</span>
			</div>
		</div>
	</div>

	<!-- Card Controls -->
	<div class="card-actions-row">
		<button type="button" class="btn-card-action" id="btn-freeze-card">
			<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M12 2v20M2 12h20M4.93 4.93l14.14 14.14M4.93 19.07L19.07 4.93"/>
			</svg>
			<span id="freeze-text">Lock Card</span>
		</button>
		<button type="button" class="btn-card-action" id="btn-reveal-details">
			<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
				<circle cx="12" cy="12" r="3"/>
			</svg>
			<span>Card Details</span>
		</button>
		<button type="button" class="btn-card-action" id="btn-limits">
			<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="12" cy="12" r="3"/>
				<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
			</svg>
			<span>Limits</span>
		</button>
	</div>
</div>

<script>
	import { api } from '../../lib/api';

	document.addEventListener('DOMContentLoaded', () => {
		// Populate cardholder name from authenticated user profile
		const user = api.getUser();
		if (user?.full_name) {
			const holderEl = document.getElementById('card-holder-name');
			if (holderEl) holderEl.textContent = user.full_name;
		}

		// Interactive Toggle for Lock Card
		const btnFreeze = document.getElementById('btn-freeze-card');
		const freezeText = document.getElementById('freeze-text');
		const cardEl = document.getElementById('metal-card-element');
		let isFrozen = false;

		btnFreeze?.addEventListener('click', () => {
			isFrozen = !isFrozen;
			if (freezeText) freezeText.textContent = isFrozen ? 'Unlock' : 'Lock Card';
			if (cardEl) {
				cardEl.style.opacity = isFrozen ? '0.6' : '1';
				cardEl.style.filter = isFrozen ? 'grayscale(0.8)' : 'none';
			}
		});

		// Toggle Card Number reveal
		const btnReveal = document.getElementById('btn-reveal-details');
		const digitsEl = document.getElementById('card-digits');
		let isRevealed = false;

		btnReveal?.addEventListener('click', () => {
			isRevealed = !isRevealed;
			if (digitsEl) {
				digitsEl.innerHTML = isRevealed ? '4921 &nbsp;8830 &nbsp;7145 &nbsp;8842' : '•••• &nbsp;•••• &nbsp;•••• &nbsp;8842';
			}
		});
	});
</script>
