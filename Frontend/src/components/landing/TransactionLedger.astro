---
// Recent Banking Transaction Ledger Component
---

<section class="ledger-section" id="transfers">
	<div class="ledger-header">
		<div class="ledger-title-group">
			<h2 class="ledger-title">Activity Ledger</h2>
			<p class="ledger-caption">Real-time cleared transactions and cryptographic receipts</p>
		</div>

		<div class="ledger-filter-group" id="ledger-filter-chips">
			<button type="button" class="filter-chip active" data-filter="all">All</button>
			<button type="button" class="filter-chip" data-filter="inbound">Credits</button>
			<button type="button" class="filter-chip" data-filter="outbound">Debits</button>
			<button type="button" class="filter-chip" data-filter="yield">Yields</button>
		</div>
	</div>

	<table class="ledger-table" aria-label="Transaction Records">
		<thead>
			<tr>
				<th scope="col">Recipient / Counterparty</th>
				<th scope="col">Reference ID</th>
				<th scope="col">Date & Time</th>
				<th scope="col">Status</th>
				<th scope="col" style="text-align: right;">Settlement Amount</th>
			</tr>
		</thead>
		<tbody id="ledger-rows">
			<!-- Row 1 -->
			<tr data-type="inbound">
				<td>
					<div class="tx-entity-cell">
						<div class="tx-icon-circle credit">
							<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
								<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
								<polyline points="17 6 23 6 23 12"/>
							</svg>
						</div>
						<div>
							<span class="tx-entity-name">Zurich Wealth Prime Inflow</span>
							<span class="tx-category-tag">Interbank SWIFT Settlement</span>
						</div>
					</div>
				</td>
				<td style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--white-40);">TX-990142-CH</td>
				<td style="color: var(--white-60);">Today, 10:42 AM</td>
				<td><span class="tx-status-badge completed">Cleared</span></td>
				<td class="tx-amount positive">+$45,000.00</td>
			</tr>

			<!-- Row 2 -->
			<tr data-type="yield">
				<td>
					<div class="tx-entity-cell">
						<div class="tx-icon-circle credit">
							<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
								<circle cx="12" cy="12" r="10"/>
								<path d="M12 6v6l4 2"/>
							</svg>
						</div>
						<div>
							<span class="tx-entity-name">Prime Vault Tier Yield</span>
							<span class="tx-category-tag">Daily Compound APY Distribution</span>
						</div>
					</div>
				</td>
				<td style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--white-40);">YLD-0821-CX</td>
				<td style="color: var(--white-60);">Today, 06:00 AM</td>
				<td><span class="tx-status-badge completed">Auto-Compounded</span></td>
				<td class="tx-amount positive">+$1,842.15</td>
			</tr>

			<!-- Row 3 -->
			<tr data-type="outbound">
				<td>
					<div class="tx-entity-cell">
						<div class="tx-icon-circle">
							<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
								<polyline points="1 18 10.5 8.5 15.5 13.5 23 6"/>
								<polyline points="17 6 23 6 23 12"/>
							</svg>
						</div>
						<div>
							<span class="tx-entity-name">Apex Global Liquidity Wire</span>
							<span class="tx-category-tag">Securities Clearance</span>
						</div>
					</div>
				</td>
				<td style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--white-40);">FED-7712-NY</td>
				<td style="color: var(--white-60);">Yesterday, 04:15 PM</td>
				<td><span class="tx-status-badge completed">Cleared</span></td>
				<td class="tx-amount" style="color: var(--white-90);">- $8,500.00</td>
			</tr>

			<!-- Row 4 -->
			<tr data-type="outbound">
				<td>
					<div class="tx-entity-cell">
						<div class="tx-icon-circle">
							<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
								<rect x="1" y="4" width="22" height="16" rx="2"/>
								<line x1="1" y1="10" x2="23" y2="10"/>
							</svg>
						</div>
						<div>
							<span class="tx-entity-name">Apple Enterprise Systems</span>
							<span class="tx-category-tag">Black Metal Card •• 8842</span>
						</div>
					</div>
				</td>
				<td style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--white-40);">POS-4481-CA</td>
				<td style="color: var(--white-60);">Oct 29, 02:22 PM</td>
				<td><span class="tx-status-badge completed">Settled</span></td>
				<td class="tx-amount" style="color: var(--white-90);">- $2,499.00</td>
			</tr>

			<!-- Row 5 -->
			<tr data-type="inbound">
				<td>
					<div class="tx-entity-cell">
						<div class="tx-icon-circle credit">
							<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
								<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
								<polyline points="17 6 23 6 23 12"/>
							</svg>
						</div>
						<div>
							<span class="tx-entity-name">Geneva Private Equity Dividend</span>
							<span class="tx-category-tag">Direct Wire Deposit</span>
						</div>
					</div>
				</td>
				<td style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--white-40);">DIV-1980-EU</td>
				<td style="color: var(--white-60);">Oct 27, 09:12 AM</td>
				<td><span class="tx-status-badge completed">Cleared</span></td>
				<td class="tx-amount positive">+$18,750.00</td>
			</tr>
		</tbody>
	</table>
</section>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const filterChips = document.querySelectorAll('#ledger-filter-chips .filter-chip');
		const rows = document.querySelectorAll('#ledger-rows tr');

		filterChips.forEach((chip) => {
			chip.addEventListener('click', () => {
				filterChips.forEach((c) => c.classList.remove('active'));
				chip.classList.add('active');

				const filter = chip.getAttribute('data-filter');

				rows.forEach((row) => {
					const rowType = row.getAttribute('data-type');
					if (filter === 'all' || rowType === filter) {
						(row as HTMLElement).style.display = '';
					} else {
						(row as HTMLElement).style.display = 'none';
					}
				});
			});
		});
	});
</script>
