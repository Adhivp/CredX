---
interface Props {
  active?: string;
}
const { active = "dashboard" } = Astro.props;
---

<aside class="dash-nav" id="dash-sidebar">
  <div class="dash-nav-top">
    <!-- Brand Logo & System Title -->
    <a href="/dashboard" class="dash-nav-brand">
      <div class="brand-logo-frame">
        <img src="/logo.png" alt="CredX Emblem" class="brand-logo-img" />
      </div>
      <div class="brand-text-block">
        <span class="brand-name">Cred<span class="gold-text">X</span></span>
        <span class="brand-subtext">Risk Intelligence</span>
      </div>
    </a>
    <button type="button" class="nav-menu-toggle" id="nav-menu-toggle" aria-controls="dash-sidebar" aria-expanded="false" aria-label="Open menu">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>

    <!-- Engine Status Pill -->
    <div class="engine-status-pill">
      <span class="pulse-dot"></span>
      <span class="status-label">ML Risk Engine Live</span>
    </div>

    <!-- Navigation Section -->
    <div class="nav-section-title">PORTFOLIO MONITORING</div>
    <ul class="dash-nav-links">
      <li>
        <a href="/dashboard" class={`nav-item ${active === "dashboard" ? "active" : ""}`}>
          <span class="nav-icon-wrap">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7" rx="1.5"/>
              <rect x="14" y="3" width="7" height="7" rx="1.5"/>
              <rect x="14" y="14" width="7" height="7" rx="1.5"/>
              <rect x="3" y="14" width="7" height="7" rx="1.5"/>
            </svg>
          </span>
          <span class="nav-text">Overview</span>
          {active === "dashboard" && <span class="active-indicator"></span>}
        </a>
      </li>
      <li>
        <a href="/watchlist" class={`nav-item ${active === "watchlist" ? "active" : ""}`}>
          <span class="nav-icon-wrap">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
          </span>
          <span class="nav-text">Risk Watchlist</span>
          {active === "watchlist" && <span class="active-indicator"></span>}
        </a>
      </li>
    </ul>
    <div class="nav-section-title">RISK INTERVENTION</div>
    <ul class="dash-nav-links">
      <li>
        <a href="/portfolio" class={`nav-item ${active === "portfolio" ? "active" : ""}`}>
          <span class="nav-icon-wrap">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 17 9 11 13 15 21 7"/><polyline points="14 7 21 7 21 14"/></svg>
          </span>
          <span class="nav-text">Portfolio Monitor</span>
          {active === "portfolio" && <span class="active-indicator"></span>}
        </a>
      </li>
      <li>
        <a href="/priority" class={`nav-item ${active === "priority" ? "active" : ""}`}>
          <span class="nav-icon-wrap">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><circle cx="4" cy="6" r="1"/><circle cx="4" cy="12" r="1"/><circle cx="4" cy="18" r="1"/></svg>
          </span>
          <span class="nav-text">Priority Queue</span>
          {active === "priority" && <span class="active-indicator"></span>}
        </a>
      </li>
      <li>
        <a href="/interventions" class={`nav-item ${active === "interventions" ? "active" : ""}`}>
          <span class="nav-icon-wrap">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          </span>
          <span class="nav-text">Interventions</span>
          {active === "interventions" && <span class="active-indicator"></span>}
        </a>
      </li>
    </ul>
    <div class="nav-section-title">AI INVESTIGATIONS</div>
    <ul class="dash-nav-links">
      <li>
        <a href="/investigations" class={`nav-item ${active === "investigations" ? "active" : ""}`}>
          <span class="nav-icon-wrap">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><path d="M8 11h6M11 8v6"/></svg>
          </span>
          <span class="nav-text">Investigations</span>
          {active === "investigations" && <span class="active-indicator"></span>}
        </a>
      </li>
      <li>
        <a href="/reviews" class={`nav-item ${active === "reviews" ? "active" : ""}`}>
          <span class="nav-icon-wrap">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><rect x="3" y="4" width="13" height="16" rx="2"/></svg>
          </span>
          <span class="nav-text">Review Queue</span>
          {active === "reviews" && <span class="active-indicator"></span>}
        </a>
      </li>
      <li>
        <a href="/governed" class={`nav-item ${active === "governed" ? "active" : ""}`}>
          <span class="nav-icon-wrap">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6z"/></svg>
          </span>
          <span class="nav-text">Governed EWS</span>
          {active === "governed" && <span class="active-indicator"></span>}
        </a>
      </li>
    </ul>
    <div class="nav-section-title">GOVERNANCE</div>
    <ul class="dash-nav-links">
      <li>
        <a href="/admin" class={`nav-item ${active === "admin" ? "active" : ""}`}>
          <span class="nav-icon-wrap">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="8" r="4"/><path d="M2 21c0-4 3-7 7-7s7 3 7 7"/><path d="M19 8v6M16 11h6"/></svg>
          </span>
          <span class="nav-text">Administration</span>
          {active === "admin" && <span class="active-indicator"></span>}
        </a>
      </li>
      <li>
        <a href="/system" class={`nav-item ${active === "system" ? "active" : ""}`}>
          <span class="nav-icon-wrap">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="12" rx="2"/><line x1="8" y1="20" x2="16" y2="20"/><line x1="12" y1="16" x2="12" y2="20"/></svg>
          </span>
          <span class="nav-text">System & Audit</span>
          {active === "system" && <span class="active-indicator"></span>}
        </a>
      </li>
    </ul>
    <div class="nav-section-title">DATA</div>
    <ul class="dash-nav-links">
      <li>
        <a href="/upload" class={`nav-item ${active === "upload" ? "active" : ""}`}>
          <span class="nav-icon-wrap">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="17 8 12 3 7 8"/>
              <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
          </span>
          <span class="nav-text">Upload Portfolio</span>
          {active === "upload" && <span class="active-indicator"></span>}
        </a>
      </li>
    </ul>
  </div>

</aside>

<script>
  // Phone layout: the sidebar collapses to a top bar; this button opens the menu.
  const sidebar = document.getElementById('dash-sidebar');
  const toggle = document.getElementById('nav-menu-toggle');
  toggle?.addEventListener('click', () => {
    const open = sidebar?.classList.toggle('open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
  // Keep the active item in view when the sidebar scrolls.
  sidebar?.querySelector('.nav-item.active')?.scrollIntoView({ block: 'nearest' });
</script>
