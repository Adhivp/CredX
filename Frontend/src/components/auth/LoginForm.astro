---
import BrandLogo from '../common/BrandLogo.astro';
---

<section class="auth-panel" id="auth-panel">
	<div class="auth-card" id="auth-card">
		<!-- Mobile Brand Header -->
		<div class="mobile-brand">
			<BrandLogo size="sm" />
		</div>

		<!-- Card Header -->
		<header class="card-header">
			<span class="header-tag" id="auth-mode-tag">Client Portal</span>
			<h2 class="header-title" id="auth-title">Welcome back</h2>
			<p class="header-desc" id="auth-desc">Enter your credentials to securely access your account</p>
		</header>

		<!-- Real-time Feedback Banner -->
		<div class="auth-alert" id="auth-alert" role="alert">
			<svg id="alert-icon-error" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="12" cy="12" r="10"/>
				<line x1="12" y1="8" x2="12" y2="12"/>
				<line x1="12" y1="16" x2="12.01" y2="16"/>
			</svg>
			<svg id="alert-icon-success" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" style="display:none;">
				<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
				<polyline points="22 4 12 14.01 9 11.01"/>
			</svg>
			<span id="auth-alert-message"></span>
		</div>

		<!-- Login & Registration Form -->
		<form class="credential-form" id="login-form" novalidate>
			<!-- Full Name (Only visible in registration mode) -->
			<div class="field-group" id="name-field-group" style="display: none;">
				<div class="field-label-row">
					<label for="full_name" class="field-label">Full Name</label>
				</div>
				<div class="field-wrapper">
					<span class="field-icon">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75">
							<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
							<circle cx="12" cy="7" r="4"/>
						</svg>
					</span>
					<input
						type="text"
						id="full_name"
						name="full_name"
						class="text-input"
						placeholder="Alexander Vance"
						autocomplete="name"
					/>
				</div>
				<span class="field-error-msg" id="name-error-msg"></span>
			</div>

			<!-- Email Address -->
			<div class="field-group" id="email-field-group">
				<div class="field-label-row">
					<label for="email" class="field-label">Email Address</label>
				</div>
				<div class="field-wrapper">
					<span class="field-icon">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75">
							<rect x="2" y="4" width="20" height="16" rx="2" stroke-linecap="round" stroke-linejoin="round"/>
							<path d="M22 7l-10 6L2 7" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</span>
					<input
						type="email"
						id="email"
						name="email"
						class="text-input"
						placeholder="client@credx.com"
						autocomplete="email"
						required
					/>
				</div>
				<span class="field-error-msg" id="email-error-msg"></span>
			</div>

			<!-- Password -->
			<div class="field-group" id="password-field-group">
				<div class="field-label-row">
					<label for="password" class="field-label">Password</label>
					<a href="#forgot" class="link-forgot" id="forgot-password">Forgot password?</a>
				</div>
				<div class="field-wrapper">
					<span class="field-icon">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75">
							<rect x="3" y="11" width="18" height="11" rx="2" stroke-linecap="round" stroke-linejoin="round"/>
							<path d="M7 11V7a5 5 0 0 1 10 0v4" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</span>
					<input
						type="password"
						id="password"
						name="password"
						class="text-input has-toggle"
						placeholder="Enter your security password"
						autocomplete="current-password"
						required
					/>
					<button type="button" class="password-toggle-btn" id="toggle-password" aria-label="Toggle password visibility">
						<svg class="eye-show" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75">
							<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke-linecap="round" stroke-linejoin="round"/>
							<circle cx="12" cy="12" r="3"/>
						</svg>
						<svg class="eye-hide" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" style="display:none">
							<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" stroke-linecap="round" stroke-linejoin="round"/>
							<line x1="1" y1="1" x2="23" y2="23" stroke-linecap="round"/>
						</svg>
					</button>
				</div>
				<span class="field-error-msg" id="password-error-msg"></span>
			</div>

			<!-- Options: Remember Device -->
			<div class="form-checkbox-row" id="remember-row">
				<label class="custom-checkbox-container" id="remember-device-label">
					<input type="checkbox" id="remember" name="remember" checked />
					<span class="checkbox-visual">
						<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="3">
							<path d="M5 12l5 5L20 7" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</span>
					<span class="checkbox-caption">Trust this device for 30 days</span>
				</label>
			</div>

			<!-- Primary Submit Button -->
			<button type="submit" class="primary-btn" id="btn-login">
				<span class="btn-text" id="btn-text">Sign In to CredX</span>
				<span class="btn-spinner" style="display: none;">
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none">
						<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-dasharray="60" stroke-dashoffset="20"/>
					</svg>
				</span>
				<span class="btn-arrow-icon">
					<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.25">
						<path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
				</span>
			</button>
		</form>

		<!-- Mode Switcher -->
		<p class="account-prompt">
			<span id="account-prompt-text">New to CredX?</span>
			<a href="#register" class="link-gold" id="toggle-auth-mode">Open a private account</a>
		</p>

		<!-- Alternative Login Divider -->
		<div class="auth-divider">
			<span class="divider-line"></span>
			<span class="divider-label">or authenticate with</span>
			<span class="divider-line"></span>
		</div>

		<!-- SSO Social Buttons -->
		<div class="sso-grid">
			<button class="sso-btn" id="sso-google" type="button">
				<svg viewBox="0 0 24 24" width="18" height="18">
					<path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
					<path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
					<path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18A10.96 10.96 0 0 0 1 12c0 1.77.42 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
					<path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
				</svg>
				<span>Google Workspace</span>
			</button>

			<button class="sso-btn" id="sso-apple" type="button">
				<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
					<path d="M17.05 20.28c-.98.95-2.05.88-3.08.4-1.09-.5-2.08-.48-3.24 0-1.44.62-2.2.44-3.06-.4C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
				</svg>
				<span>Apple Passkey</span>
			</button>
		</div>

		<!-- Security Badging & Legal Footer -->
		<footer class="card-footer">
			<div class="compliance-row">
				<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
					<rect x="3" y="11" width="18" height="11" rx="2" stroke-linecap="round" stroke-linejoin="round"/>
					<path d="M7 11V7a5 5 0 0 1 10 0v4" stroke-linecap="round" stroke-linejoin="round"/>
				</svg>
				<span>Connected to https://credx-auwn.onrender.com</span>
			</div>
			<div class="legal-nav">
				<a href="#privacy">Privacy</a>
				<span class="nav-bullet">·</span>
				<a href="#terms">Terms</a>
				<span class="nav-bullet">·</span>
				<a href="#security">Security Architecture</a>
			</div>
		</footer>
	</div>
</section>

<script>
	import { api } from '../../lib/api';

	document.addEventListener('DOMContentLoaded', () => {
		const form = document.getElementById('login-form') as HTMLFormElement | null;
		const nameFieldGroup = document.getElementById('name-field-group');
		const nameInput = document.getElementById('full_name') as HTMLInputElement | null;
		const emailInput = document.getElementById('email') as HTMLInputElement | null;
		const passwordInput = document.getElementById('password') as HTMLInputElement | null;
		const toggleBtn = document.getElementById('toggle-password') as HTMLButtonElement | null;
		const btnLogin = document.getElementById('btn-login') as HTMLButtonElement | null;
		const btnText = document.getElementById('btn-text');
		const toggleAuthMode = document.getElementById('toggle-auth-mode');
		const authModeTag = document.getElementById('auth-mode-tag');
		const authTitle = document.getElementById('auth-title');
		const authDesc = document.getElementById('auth-desc');
		const promptText = document.getElementById('account-prompt-text');
		const alertBanner = document.getElementById('auth-alert');
		const alertMessage = document.getElementById('auth-alert-message');
		const alertIconError = document.getElementById('alert-icon-error');
		const alertIconSuccess = document.getElementById('alert-icon-success');

		let isRegisterMode = false;

		function showAlert(message: string, isError = true) {
			if (!alertBanner || !alertMessage) return;
			alertBanner.className = `auth-alert visible ${isError ? 'error' : 'success'}`;
			alertMessage.textContent = message;
			if (alertIconError) alertIconError.style.display = isError ? 'block' : 'none';
			if (alertIconSuccess) alertIconSuccess.style.display = isError ? 'none' : 'block';
		}

		function hideAlert() {
			if (!alertBanner) return;
			alertBanner.className = 'auth-alert';
		}

		// Switch between Login and Registration mode
		toggleAuthMode?.addEventListener('click', (e) => {
			e.preventDefault();
			isRegisterMode = !isRegisterMode;
			hideAlert();

			if (isRegisterMode) {
				if (nameFieldGroup) nameFieldGroup.style.display = 'flex';
				if (authModeTag) authModeTag.textContent = 'Account Application';
				if (authTitle) authTitle.textContent = 'Open an Account';
				if (authDesc) authDesc.textContent = 'Create your private banking credentials (password: 12+ chars)';
				if (btnText) btnText.textContent = 'Create CredX Account';
				if (promptText) promptText.textContent = 'Already have an account?';
				if (toggleAuthMode) toggleAuthMode.textContent = 'Sign In';
				if (passwordInput) passwordInput.placeholder = 'Min 12 characters';
			} else {
				if (nameFieldGroup) nameFieldGroup.style.display = 'none';
				if (authModeTag) authModeTag.textContent = 'Client Portal';
				if (authTitle) authTitle.textContent = 'Welcome back';
				if (authDesc) authDesc.textContent = 'Enter your credentials to securely access your account';
				if (btnText) btnText.textContent = 'Sign In to CredX';
				if (promptText) promptText.textContent = 'New to CredX?';
				if (toggleAuthMode) toggleAuthMode.textContent = 'Open a private account';
				if (passwordInput) passwordInput.placeholder = 'Enter your security password';
			}
		});

		// Password Visibility Toggle
		if (toggleBtn && passwordInput) {
			toggleBtn.addEventListener('click', () => {
				const isPassword = passwordInput.type === 'password';
				passwordInput.type = isPassword ? 'text' : 'password';

				const eyeShow = toggleBtn.querySelector('.eye-show') as SVGElement | null;
				const eyeHide = toggleBtn.querySelector('.eye-hide') as SVGElement | null;

				if (eyeShow && eyeHide) {
					eyeShow.style.display = isPassword ? 'none' : 'block';
					eyeHide.style.display = isPassword ? 'block' : 'none';
				}
			});
		}

		// Realtime Error Clearing
		nameInput?.addEventListener('input', () => {
			document.getElementById('name-field-group')?.classList.remove('has-error');
			hideAlert();
		});

		emailInput?.addEventListener('input', () => {
			document.getElementById('email-field-group')?.classList.remove('has-error');
			hideAlert();
		});

		passwordInput?.addEventListener('input', () => {
			document.getElementById('password-field-group')?.classList.remove('has-error');
			hideAlert();
		});

		// Submit Handler with Backend API integration
		form?.addEventListener('submit', async (e: Event) => {
			e.preventDefault();
			hideAlert();
			let isValid = true;

			const nameVal = nameInput?.value.trim() ?? '';
			const emailVal = emailInput?.value.trim() ?? '';
			const passwordVal = passwordInput?.value ?? '';

			const nameGroup = document.getElementById('name-field-group');
			const nameError = document.getElementById('name-error-msg');
			const emailGroup = document.getElementById('email-field-group');
			const emailError = document.getElementById('email-error-msg');
			const passwordGroup = document.getElementById('password-field-group');
			const passwordError = document.getElementById('password-error-msg');

			if (isRegisterMode) {
				if (!nameVal) {
					nameGroup?.classList.add('has-error');
					if (nameError) nameError.textContent = 'Full name is required.';
					isValid = false;
				}
			}

			// Validate Email
			if (!emailVal) {
				emailGroup?.classList.add('has-error');
				if (emailError) emailError.textContent = 'Please enter your email address.';
				isValid = false;
			} else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailVal)) {
				emailGroup?.classList.add('has-error');
				if (emailError) emailError.textContent = 'Please enter a valid email format.';
				isValid = false;
			}

			// Validate Password
			if (!passwordVal) {
				passwordGroup?.classList.add('has-error');
				if (passwordError) passwordError.textContent = 'Password is required.';
				isValid = false;
			} else if (isRegisterMode && passwordVal.length < 12) {
				passwordGroup?.classList.add('has-error');
				if (passwordError) passwordError.textContent = 'Backend security requires at least 12 characters.';
				isValid = false;
			}

			if (!isValid) return;

			// Trigger Loading State
			if (btnLogin) {
				btnLogin.classList.add('is-loading');
				btnLogin.disabled = true;
			}

			try {
				if (isRegisterMode) {
					showAlert('Registering account with CredX...', false);
					await api.register(emailVal, nameVal, passwordVal);
					showAlert('Account created! Authenticating session...', false);
				}

				// Authenticate with backend API
				const { user } = await api.login(emailVal, passwordVal);

				showAlert(`Authenticated as ${user.full_name}. Redirecting to dashboard...`, false);

				setTimeout(() => {
					window.location.href = '/landing';
				}, 600);
			} catch (err: any) {
				showAlert(err.message || 'Authentication request failed. Please check credentials.', true);
			} finally {
				if (btnLogin) {
					btnLogin.classList.remove('is-loading');
					btnLogin.disabled = false;
				}
			}
		});

		// Demo SSO fallback
		document.getElementById('sso-google')?.addEventListener('click', async () => {
			if (emailInput && passwordInput) {
				emailInput.value = 'demo@credx.com';
				passwordInput.value = 'DemoCredXPass123!';
				form?.dispatchEvent(new Event('submit', { cancelable: true }));
			}
		});

		document.getElementById('sso-apple')?.addEventListener('click', async () => {
			if (emailInput && passwordInput) {
				emailInput.value = 'client@credx.com';
				passwordInput.value = 'ClientCredXPass123!';
				form?.dispatchEvent(new Event('submit', { cancelable: true }));
			}
		});
	});
</script>
