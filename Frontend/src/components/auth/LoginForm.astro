---
import BrandLogo from '../common/BrandLogo.astro';
---

<section class="auth-panel" id="auth-panel">
	<div class="auth-card" id="auth-card">
		<!-- Mobile Brand Header -->
		<div class="mobile-brand">
			<BrandLogo size="sm" />
		</div>

		<!-- Card Header -->
		<header class="card-header">
			<span class="header-tag">Client Portal</span>
			<h2 class="header-title">Welcome back</h2>
			<p class="header-desc">Enter your credentials to securely access your account</p>
		</header>

		<!-- Login Form -->
		<form class="credential-form" id="login-form" novalidate>
			<!-- Email Address -->
			<div class="field-group" id="email-field-group">
				<div class="field-label-row">
					<label for="email" class="field-label">Email Address</label>
				</div>
				<div class="field-wrapper">
					<span class="field-icon">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75">
							<rect x="2" y="4" width="20" height="16" rx="2" stroke-linecap="round" stroke-linejoin="round"/>
							<path d="M22 7l-10 6L2 7" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</span>
					<input
						type="email"
						id="email"
						name="email"
						class="text-input"
						placeholder="client@credx.com"
						autocomplete="email"
						required
					/>
				</div>
				<span class="field-error-msg" id="email-error-msg"></span>
			</div>

			<!-- Password -->
			<div class="field-group" id="password-field-group">
				<div class="field-label-row">
					<label for="password" class="field-label">Password</label>
					<a href="#forgot" class="link-forgot" id="forgot-password">Forgot password?</a>
				</div>
				<div class="field-wrapper">
					<span class="field-icon">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75">
							<rect x="3" y="11" width="18" height="11" rx="2" stroke-linecap="round" stroke-linejoin="round"/>
							<path d="M7 11V7a5 5 0 0 1 10 0v4" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</span>
					<input
						type="password"
						id="password"
						name="password"
						class="text-input has-toggle"
						placeholder="Enter your security password"
						autocomplete="current-password"
						required
					/>
					<button type="button" class="password-toggle-btn" id="toggle-password" aria-label="Toggle password visibility">
						<svg class="eye-show" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75">
							<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke-linecap="round" stroke-linejoin="round"/>
							<circle cx="12" cy="12" r="3"/>
						</svg>
						<svg class="eye-hide" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" style="display:none">
							<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" stroke-linecap="round" stroke-linejoin="round"/>
							<line x1="1" y1="1" x2="23" y2="23" stroke-linecap="round"/>
						</svg>
					</button>
				</div>
				<span class="field-error-msg" id="password-error-msg"></span>
			</div>

			<!-- Options: Remember Device -->
			<div class="form-checkbox-row">
				<label class="custom-checkbox-container" id="remember-device-label">
					<input type="checkbox" id="remember" name="remember" checked />
					<span class="checkbox-visual">
						<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="3">
							<path d="M5 12l5 5L20 7" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</span>
					<span class="checkbox-caption">Trust this device for 30 days</span>
				</label>
			</div>

			<!-- Primary Sign In Button -->
			<button type="submit" class="primary-btn" id="btn-login">
				<span class="btn-text">Sign In to CredX</span>
				<span class="btn-spinner" style="display: none;">
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none">
						<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-dasharray="60" stroke-dashoffset="20"/>
					</svg>
				</span>
				<span class="btn-arrow-icon">
					<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.25">
						<path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
				</span>
			</button>
		</form>

		<!-- Alternative Login Divider -->
		<div class="auth-divider">
			<span class="divider-line"></span>
			<span class="divider-label">or authenticate with</span>
			<span class="divider-line"></span>
		</div>

		<!-- SSO Social Buttons -->
		<div class="sso-grid">
			<button class="sso-btn" id="sso-google" type="button">
				<svg viewBox="0 0 24 24" width="18" height="18">
					<path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
					<path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
					<path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18A10.96 10.96 0 0 0 1 12c0 1.77.42 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
					<path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
				</svg>
				<span>Google Workspace</span>
			</button>

			<button class="sso-btn" id="sso-apple" type="button">
				<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
					<path d="M17.05 20.28c-.98.95-2.05.88-3.08.4-1.09-.5-2.08-.48-3.24 0-1.44.62-2.2.44-3.06-.4C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
				</svg>
				<span>Apple Passkey</span>
			</button>
		</div>

		<!-- Registration Prompt -->
		<p class="account-prompt">
			New to CredX? <a href="#register" class="link-gold" id="register-link">Open a private account</a>
		</p>

		<!-- Security Badging & Legal Footer -->
		<footer class="card-footer">
			<div class="compliance-row">
				<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
					<rect x="3" y="11" width="18" height="11" rx="2" stroke-linecap="round" stroke-linejoin="round"/>
					<path d="M7 11V7a5 5 0 0 1 10 0v4" stroke-linecap="round" stroke-linejoin="round"/>
				</svg>
				<span>End-to-End Encrypted Session</span>
			</div>
			<div class="legal-nav">
				<a href="#privacy">Privacy</a>
				<span class="nav-bullet">·</span>
				<a href="#terms">Terms</a>
				<span class="nav-bullet">·</span>
				<a href="#security">Security Architecture</a>
			</div>
		</footer>
	</div>
</section>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const form = document.getElementById('login-form') as HTMLFormElement | null;
		const emailInput = document.getElementById('email') as HTMLInputElement | null;
		const passwordInput = document.getElementById('password') as HTMLInputElement | null;
		const toggleBtn = document.getElementById('toggle-password') as HTMLButtonElement | null;
		const btnLogin = document.getElementById('btn-login') as HTMLButtonElement | null;
		const ssoGoogle = document.getElementById('sso-google') as HTMLButtonElement | null;
		const ssoApple = document.getElementById('sso-apple') as HTMLButtonElement | null;

		// 1. Password Visibility Toggle
		if (toggleBtn && passwordInput) {
			toggleBtn.addEventListener('click', () => {
				const isPassword = passwordInput.type === 'password';
				passwordInput.type = isPassword ? 'text' : 'password';

				const eyeShow = toggleBtn.querySelector('.eye-show') as SVGElement | null;
				const eyeHide = toggleBtn.querySelector('.eye-hide') as SVGElement | null;

				if (eyeShow && eyeHide) {
					eyeShow.style.display = isPassword ? 'none' : 'block';
					eyeHide.style.display = isPassword ? 'block' : 'none';
				}
			});
		}

		// 2. Realtime Error Clearing
		emailInput?.addEventListener('input', () => {
			document.getElementById('email-field-group')?.classList.remove('has-error');
		});

		passwordInput?.addEventListener('input', () => {
			document.getElementById('password-field-group')?.classList.remove('has-error');
		});

		// 3. Authenticate and redirect to landing page
		function handleSuccessfulAuth(email: string) {
			if (!btnLogin) return;
			btnLogin.classList.add('is-loading');
			btnLogin.disabled = true;

			// Save authenticated session state
			const userSession = {
				email: email || 'client@credx.com',
				name: 'Alexander Vance',
				tier: 'Private Wealth Black',
				accountNumber: 'CX-8842-9901',
				loginTime: new Date().toISOString(),
			};
			sessionStorage.setItem('credx_user', JSON.stringify(userSession));

			// Simulated secure cryptographic handshake before redirecting to landing page
			setTimeout(() => {
				window.location.href = '/landing';
			}, 900);
		}

		form?.addEventListener('submit', (e: Event) => {
			e.preventDefault();
			let isValid = true;

			const emailGroup = document.getElementById('email-field-group');
			const emailError = document.getElementById('email-error-msg');
			const passwordGroup = document.getElementById('password-field-group');
			const passwordError = document.getElementById('password-error-msg');

			const emailVal = emailInput?.value.trim() ?? '';
			const passwordVal = passwordInput?.value ?? '';

			// Validate Email
			if (!emailVal) {
				emailGroup?.classList.add('has-error');
				if (emailError) emailError.textContent = 'Please enter your registered email address.';
				isValid = false;
			} else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailVal)) {
				emailGroup?.classList.add('has-error');
				if (emailError) emailError.textContent = 'Please enter a valid email format (e.g. client@credx.com).';
				isValid = false;
			}

			// Validate Password
			if (!passwordVal) {
				passwordGroup?.classList.add('has-error');
				if (passwordError) passwordError.textContent = 'Please enter your account password.';
				isValid = false;
			} else if (passwordVal.length < 6) {
				passwordGroup?.classList.add('has-error');
				if (passwordError) passwordError.textContent = 'Password must contain at least 6 characters.';
				isValid = false;
			}

			if (!isValid) return;

			handleSuccessfulAuth(emailVal);
		});

		// Quick SSO Handlers for demo convenience
		ssoGoogle?.addEventListener('click', () => {
			handleSuccessfulAuth('alexander.vance@gmail.com');
		});

		ssoApple?.addEventListener('click', () => {
			handleSuccessfulAuth('alexander.vance@icloud.com');
		});
	});
</script>
