---
import BrandLogo from "../common/BrandLogo.astro";
---

<section class="auth-panel" id="auth-panel">
	<div class="auth-card" id="auth-card">
		<!-- Mobile Brand Header -->
		<div class="mobile-brand">
			<BrandLogo size="sm" />
		</div>

		<!-- Card Header -->
		<header class="card-header">
			<span class="header-tag" id="auth-mode-tag">Client Portal</span>
			<h2 class="header-title" id="auth-title">Welcome back</h2>
			<p class="header-desc" id="auth-desc">
				Enter your credentials to securely access your account
			</p>
		</header>

		<!-- Real-time Feedback Banner -->
		<div class="auth-alert" id="auth-alert" role="alert">
			<svg
				id="alert-icon-error"
				viewBox="0 0 24 24"
				width="18"
				height="18"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
			>
				<circle cx="12" cy="12" r="10"></circle>
				<line x1="12" y1="8" x2="12" y2="12"></line>
				<line x1="12" y1="16" x2="12.01" y2="16"></line>
			</svg>
			<svg
				id="alert-icon-success"
				viewBox="0 0 24 24"
				width="18"
				height="18"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				style="display:none;"
			>
				<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
				<polyline points="22 4 12 14.01 9 11.01"></polyline>
			</svg>
			<span id="auth-alert-message"></span>
		</div>

		<!-- Login & Registration Form -->
		<form class="credential-form" id="login-form" novalidate>
			<!-- Full Name (Only visible in registration mode) -->
			<div
				class="field-group"
				id="name-field-group"
				style="display: none;"
			>
				<div class="field-label-row">
					<label for="full_name" class="field-label">Full Name</label>
				</div>
				<div class="field-wrapper">
					<span class="field-icon">
						<svg
							viewBox="0 0 24 24"
							width="18"
							height="18"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
						>
							<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"
							></path>
							<circle cx="12" cy="7" r="4"></circle>
						</svg>
					</span>
					<input
						type="text"
						id="full_name"
						name="full_name"
						class="text-input"
						placeholder="Alexander Vance"
						autocomplete="name"
					/>
				</div>
				<span class="field-error-msg" id="name-error-msg"></span>
			</div>

			<!-- Email Address -->
			<div class="field-group" id="email-field-group">
				<div class="field-label-row">
					<label for="email" class="field-label">Email Address</label>
				</div>
				<div class="field-wrapper">
					<span class="field-icon">
						<svg
							viewBox="0 0 24 24"
							width="18"
							height="18"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
						>
							<rect
								x="2"
								y="4"
								width="20"
								height="16"
								rx="2"
								stroke-linecap="round"
								stroke-linejoin="round"></rect>
							<path
								d="M22 7l-10 6L2 7"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
					</span>
					<input
						type="email"
						id="email"
						name="email"
						class="text-input"
						placeholder="client@credx.com"
						autocomplete="email"
						required
					/>
				</div>
				<span class="field-error-msg" id="email-error-msg"></span>
			</div>

			<!-- Password -->
			<div class="field-group" id="password-field-group">
				<div class="field-label-row">
					<label for="password" class="field-label">Password</label>
					<a href="#forgot" class="link-forgot" id="forgot-password"
						>Forgot password?</a
					>
				</div>
				<div class="field-wrapper">
					<span class="field-icon">
						<svg
							viewBox="0 0 24 24"
							width="18"
							height="18"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
						>
							<rect
								x="3"
								y="11"
								width="18"
								height="11"
								rx="2"
								stroke-linecap="round"
								stroke-linejoin="round"></rect>
							<path
								d="M7 11V7a5 5 0 0 1 10 0v4"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
					</span>
					<input
						type="password"
						id="password"
						name="password"
						class="text-input has-toggle"
						placeholder="Enter your security password"
						autocomplete="current-password"
						required
					/>
					<button
						type="button"
						class="password-toggle-btn"
						id="toggle-password"
						aria-label="Toggle password visibility"
					>
						<svg
							class="eye-show"
							viewBox="0 0 24 24"
							width="18"
							height="18"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
						>
							<path
								d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
							<circle cx="12" cy="12" r="3"></circle>
						</svg>
						<svg
							class="eye-hide"
							viewBox="0 0 24 24"
							width="18"
							height="18"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							style="display:none"
						>
							<path
								d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
							<line
								x1="1"
								y1="1"
								x2="23"
								y2="23"
								stroke-linecap="round"></line>
						</svg>
					</button>
				</div>
				<span class="field-error-msg" id="password-error-msg"></span>
			</div>

			<!-- Options: Remember Device -->
			<div class="form-checkbox-row" id="remember-row">
				<label
					class="custom-checkbox-container"
					id="remember-device-label"
				>
					<input
						type="checkbox"
						id="remember"
						name="remember"
						checked
					/>
					<span class="checkbox-visual">
						<svg
							viewBox="0 0 24 24"
							width="11"
							height="11"
							fill="none"
							stroke="currentColor"
							stroke-width="3"
						>
							<path
								d="M5 12l5 5L20 7"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
					</span>
					<span class="checkbox-caption"
						>Trust this device for 30 days</span
					>
				</label>
			</div>

			<!-- Primary Submit Button -->
			<button type="submit" class="primary-btn" id="btn-login">
				<span class="btn-text" id="btn-text">Sign In to CredX</span>
				<span class="btn-spinner" style="display: none;">
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none">
						<circle
							cx="12"
							cy="12"
							r="10"
							stroke="currentColor"
							stroke-width="3"
							stroke-linecap="round"
							stroke-dasharray="60"
							stroke-dashoffset="20"></circle>
					</svg>
				</span>
				<span class="btn-arrow-icon">
					<svg
						viewBox="0 0 24 24"
						width="18"
						height="18"
						fill="none"
						stroke="currentColor"
						stroke-width="2.25"
					>
						<path
							d="M5 12h14M12 5l7 7-7 7"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
				</span>
			</button>
		</form>

		<!-- Mode Switcher -->
		<p class="account-prompt">
			<span id="account-prompt-text">New to CredX?</span>
			<a href="#register" class="link-gold" id="toggle-auth-mode"
				>Open a private account</a
			>
		</p>
	</div>
</section>

<script>
	import { api } from "../../lib/api";

	document.addEventListener("DOMContentLoaded", () => {
		const form = document.getElementById(
			"login-form",
		) as HTMLFormElement | null;
		const nameFieldGroup = document.getElementById("name-field-group");
		const nameInput = document.getElementById(
			"full_name",
		) as HTMLInputElement | null;
		const emailInput = document.getElementById(
			"email",
		) as HTMLInputElement | null;
		const passwordInput = document.getElementById(
			"password",
		) as HTMLInputElement | null;
		const toggleBtn = document.getElementById(
			"toggle-password",
		) as HTMLButtonElement | null;
		const btnLogin = document.getElementById(
			"btn-login",
		) as HTMLButtonElement | null;
		const btnText = document.getElementById("btn-text");
		const toggleAuthMode = document.getElementById("toggle-auth-mode");
		const authModeTag = document.getElementById("auth-mode-tag");
		const authTitle = document.getElementById("auth-title");
		const authDesc = document.getElementById("auth-desc");
		const promptText = document.getElementById("account-prompt-text");
		const alertBanner = document.getElementById("auth-alert");
		const alertMessage = document.getElementById("auth-alert-message");
		const alertIconError = document.getElementById("alert-icon-error");
		const alertIconSuccess = document.getElementById("alert-icon-success");

		let isRegisterMode = false;

		function showAlert(message: string, isError = true) {
			if (!alertBanner || !alertMessage) return;
			alertBanner.className = `auth-alert visible ${isError ? "error" : "success"}`;
			alertMessage.textContent = message;
			if (alertIconError)
				alertIconError.style.display = isError ? "block" : "none";
			if (alertIconSuccess)
				alertIconSuccess.style.display = isError ? "none" : "block";
		}

		function hideAlert() {
			if (!alertBanner) return;
			alertBanner.className = "auth-alert";
		}

		// Switch between Login and Registration mode
		toggleAuthMode?.addEventListener("click", (e) => {
			e.preventDefault();
			isRegisterMode = !isRegisterMode;
			hideAlert();

			if (isRegisterMode) {
				if (nameFieldGroup) nameFieldGroup.style.display = "flex";
				if (authModeTag)
					authModeTag.textContent = "Account Application";
				if (authTitle) authTitle.textContent = "Open an Account";
				if (authDesc)
					authDesc.textContent =
						"Create your private banking credentials (password: 12+ chars)";
				if (btnText) btnText.textContent = "Create CredX Account";
				if (promptText)
					promptText.textContent = "Already have an account?";
				if (toggleAuthMode) toggleAuthMode.textContent = "Sign In";
				if (passwordInput)
					passwordInput.placeholder = "Min 12 characters";
			} else {
				if (nameFieldGroup) nameFieldGroup.style.display = "none";
				if (authModeTag) authModeTag.textContent = "Client Portal";
				if (authTitle) authTitle.textContent = "Welcome back";
				if (authDesc)
					authDesc.textContent =
						"Enter your credentials to securely access your account";
				if (btnText) btnText.textContent = "Sign In to CredX";
				if (promptText) promptText.textContent = "New to CredX?";
				if (toggleAuthMode)
					toggleAuthMode.textContent = "Open a private account";
				if (passwordInput)
					passwordInput.placeholder = "Enter your security password";
			}
		});

		// Password Visibility Toggle
		if (toggleBtn && passwordInput) {
			toggleBtn.addEventListener("click", () => {
				const isPassword = passwordInput.type === "password";
				passwordInput.type = isPassword ? "text" : "password";

				const eyeShow = toggleBtn.querySelector(
					".eye-show",
				) as SVGElement | null;
				const eyeHide = toggleBtn.querySelector(
					".eye-hide",
				) as SVGElement | null;

				if (eyeShow && eyeHide) {
					eyeShow.style.display = isPassword ? "none" : "block";
					eyeHide.style.display = isPassword ? "block" : "none";
				}
			});
		}

		// Realtime Error Clearing
		nameInput?.addEventListener("input", () => {
			document
				.getElementById("name-field-group")
				?.classList.remove("has-error");
			hideAlert();
		});

		emailInput?.addEventListener("input", () => {
			document
				.getElementById("email-field-group")
				?.classList.remove("has-error");
			hideAlert();
		});

		passwordInput?.addEventListener("input", () => {
			document
				.getElementById("password-field-group")
				?.classList.remove("has-error");
			hideAlert();
		});

		// Submit Handler with Backend API integration
		form?.addEventListener("submit", async (e: Event) => {
			e.preventDefault();
			hideAlert();
			let isValid = true;

			const nameVal = nameInput?.value.trim() ?? "";
			const emailVal = emailInput?.value.trim() ?? "";
			const passwordVal = passwordInput?.value ?? "";

			const nameGroup = document.getElementById("name-field-group");
			const nameError = document.getElementById("name-error-msg");
			const emailGroup = document.getElementById("email-field-group");
			const emailError = document.getElementById("email-error-msg");
			const passwordGroup = document.getElementById(
				"password-field-group",
			);
			const passwordError = document.getElementById("password-error-msg");

			if (isRegisterMode) {
				if (!nameVal) {
					nameGroup?.classList.add("has-error");
					if (nameError)
						nameError.textContent = "Full name is required.";
					isValid = false;
				}
			}

			// Validate Email
			if (!emailVal) {
				emailGroup?.classList.add("has-error");
				if (emailError)
					emailError.textContent = "Please enter your email address.";
				isValid = false;
			} else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailVal)) {
				emailGroup?.classList.add("has-error");
				if (emailError)
					emailError.textContent =
						"Please enter a valid email format.";
				isValid = false;
			}

			// Validate Password
			if (!passwordVal) {
				passwordGroup?.classList.add("has-error");
				if (passwordError)
					passwordError.textContent = "Password is required.";
				isValid = false;
			} else if (isRegisterMode && passwordVal.length < 12) {
				passwordGroup?.classList.add("has-error");
				if (passwordError)
					passwordError.textContent =
						"Backend security requires at least 12 characters.";
				isValid = false;
			}

			if (!isValid) return;

			// Trigger Loading State
			if (btnLogin) {
				btnLogin.classList.add("is-loading");
				btnLogin.disabled = true;
			}

			try {
				if (isRegisterMode) {
					showAlert("Registering account with CredX...", false);
					await api.register(emailVal, nameVal, passwordVal);
					showAlert(
						"Account created! Authenticating session...",
						false,
					);
				}

				// Authenticate with backend API
				const { user } = await api.login(emailVal, passwordVal);

				showAlert(
					`Authenticated as ${user.full_name}. Redirecting to dashboard...`,
					false,
				);

				setTimeout(() => {
					window.location.href = "/dashboard";
				}, 600);
			} catch (err: any) {
				showAlert(
					err.message ||
						"Authentication request failed. Please check credentials.",
					true,
				);
			} finally {
				if (btnLogin) {
					btnLogin.classList.remove("is-loading");
					btnLogin.disabled = false;
				}
			}
		});

		// Check if already authenticated on initial load
		if (api.isAuthenticated()) {
			api.getMe()
				.then(() => {
					window.location.href = "/dashboard";
				})
				.catch(() => {
					api.clearStorage();
				});
		}
	});
</script>
