---
import BrandLogo from "../common/BrandLogo.astro";
---

<section class="brand-showcase" id="brand-showcase">
	<div class="showcase-content">
		<div class="brand-header">
			<BrandLogo size="lg" />
		</div>

		<p class="brand-headline">
			The new standard for<br />
			<span class="headline-gradient">intelligent digital banking</span>
		</p>

		<!-- Security & Feature Highlights -->
		<div class="feature-list">
			<div class="feature-card">
				<div class="feature-icon">
					<svg
						viewBox="0 0 24 24"
						width="20"
						height="20"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
					>
						<path
							d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
						<path
							d="M9 12l2 2 4-4"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
				</div>
				<div class="feature-info">
					<h3 class="feature-heading">Institutional Security</h3>
					<p class="feature-text">
						Multi-layered cryptographic vaults safeguarding every dollar
					</p>
				</div>
			</div>

			<div class="feature-card">
				<div class="feature-icon">
					<svg
						viewBox="0 0 24 24"
						width="20"
						height="20"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
					>
						<path
							d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
				</div>
				<div class="feature-info">
					<h3 class="feature-heading">Zero-Latency Settlement</h3>
					<p class="feature-text">
						High-speed global transfers with real-time liquidity clearance
					</p>
				</div>
			</div>

			<div class="feature-card">
				<div class="feature-icon">
					<svg
						viewBox="0 0 24 24"
						width="20"
						height="20"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
					>
						<circle cx="12" cy="12" r="10"></circle>
						<path
							d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
						></path>
					</svg>
				</div>
				<div class="feature-info">
					<h3 class="feature-heading">
						Borderless Financial Network
					</h3>
					<p class="feature-text">
						Seamless multi-currency management across 160+ jurisdictions
					</p>
				</div>
			</div>
		</div>
	</div>
</section>
