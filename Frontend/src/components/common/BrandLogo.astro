---
interface Props {
	size?: 'sm' | 'md' | 'lg';
	showText?: boolean;
}

const { size = 'md', showText = true } = Astro.props;

const dimensions = {
	sm: { width: 34, height: 34, textSize: '1.4rem' },
	md: { width: 48, height: 48, textSize: '2.1rem' },
	lg: { width: 62, height: 62, textSize: '2.8rem' },
}[size];
---

<div class={`brand-logo-component size-${size}`}>
	<div class="logo-emblem-wrap" style={`width: ${dimensions.width}px; height: ${dimensions.height}px;`}>
		<img src="/logo.png" alt="CredX Emblem" class="logo-image" />
	</div>
	{showText && (
		<span class="logo-title" style={`font-size: ${dimensions.textSize};`}>
			Cred<span class="gold-text">X</span>
		</span>
	)}
</div>

<style>
	.brand-logo-component {
		display: inline-flex;
		align-items: center;
		gap: 0.85rem;
		user-select: none;
	}

	.logo-emblem-wrap {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		filter: drop-shadow(0 4px 16px rgba(245, 197, 24, 0.35));
		transition: transform var(--ease-fast);
	}

	.brand-logo-component:hover .logo-emblem-wrap {
		transform: scale(1.05);
	}

	.logo-image {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.logo-title {
		font-family: var(--font-display);
		font-weight: 800;
		color: var(--white);
		letter-spacing: -0.03em;
		line-height: 1;
	}

	.gold-text {
		color: var(--gold-500);
	}
</style>
